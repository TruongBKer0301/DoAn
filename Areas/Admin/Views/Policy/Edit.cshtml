@model LapTopBD.Models.ViewModels.Admin.PolicyEditorViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quan ly chinh sach";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h2 class="mb-0">Quan ly chinh sach</h2>
        <a asp-action="Create" asp-controller="Policy" asp-area="Admin" class="btn btn-primary">
            <i class="ri-add-line me-1"></i> Them chinh sach
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-primary">
                <tr>
                    <th>Tieu de</th>
                    <th>Duong dan</th>
                    <th>Trang thai</th>
                    <th>Cap nhat</th>
                    <th class="text-center" style="width: 130px;">Hanh dong</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Policies.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Chua co chinh sach nao.</td>
                    </tr>
                }
                else
                {
                    @foreach (var policy in Model.Policies)
                    {
                        <tr>
                            <td class="fw-semibold">@policy.Title</td>
                            <td>
                                <a href="/chinh-sach/@policy.Slug" target="_blank">/chinh-sach/@policy.Slug</a>
                            </td>
                            <td>
                                @if (policy.IsPublished)
                                {
                                    <span class="badge bg-success">Dang hien thi</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">An</span>
                                }
                            </td>
                            <td>@policy.UpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                <a asp-action="Update" asp-controller="Policy" asp-area="Admin" asp-route-id="@policy.Id"
                                   class="btn btn-sm btn-outline-primary me-1" title="Sua">
                                    <i class="ri-pencil-line"></i>
                                </a>
                                <form asp-action="Delete" asp-controller="Policy" asp-area="Admin" asp-route-id="@policy.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Ban co chac muon xoa chinh sach nay?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xoa">
                                        <i class="ri-delete-bin-6-line"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
