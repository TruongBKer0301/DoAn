@model LapTopBD.Models.ViewModels.Admin.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="analytics-page py-3">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="mb-1 fw-bold">Dashboard Doanh Số</h3>
            <p class="text-muted mb-0">Thống kê doanh thu & đơn hàng theo thời gian</p>
        </div>
        <form id="dashboardFilterForm" method="get" action="@Url.Action("Dashboard", "Admin")"
              class="d-flex align-items-center gap-2 flex-wrap">
            <select name="month" class="form-select form-select-sm filter-select">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(Model.SelectedMonth == m ? "selected" : null)">Tháng @m</option>
                }
            </select>
            <select name="year" class="form-select form-select-sm filter-select">
                @for (var y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++)
                {
                    <option value="@y" selected="@(Model.SelectedYear == y ? "selected" : null)">Năm @y</option>
                }
            </select>
            <button type="submit" class="btn btn-filter btn-sm px-4 fw-semibold">
                <i class="ti ti-chart-bar me-1"></i> Thống kê
            </button>
        </form>
    </div>

    <!-- KPI ROW -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-box kpi-gold">
                <div class="kpi-icon"><i class="ti ti-coin"></i></div>
                <div class="kpi-content">
                    <p>Doanh thu tuần này</p>
                    <h3>@Model.WeekRevenue.ToString("N0") đ</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-box kpi-blue">
                <div class="kpi-icon"><i class="ti ti-shopping-cart"></i></div>
                <div class="kpi-content">
                    <p>Tổng đơn hàng</p>
                    <h3>@Model.TotalOrders</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-box kpi-green">
                <div class="kpi-icon"><i class="ti ti-users"></i></div>
                <div class="kpi-content">
                    <p>Tổng người dùng</p>
                    <h3>@Model.TotalUsers</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-box kpi-dark">
                <div class="kpi-icon"><i class="ti ti-device-laptop"></i></div>
                <div class="kpi-content">
                    <p>Sản phẩm</p>
                    <h3>@Model.TotalProduct</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- CHART DOANH THU THEO THÁNG -->
    <div class="row g-3 mb-4">
        <div class="col-xl-12">
            <div class="dash-box">
                <div class="dash-box-header">
                    <h5 class="dash-box-title">
                        <i class="ti ti-chart-line me-2"></i>
                        Doanh thu theo ngày — Tháng @Model.SelectedMonth/@Model.SelectedYear
                    </h5>
                    <span class="badge-revenue">
                        Tổng: @Model.MonthlyVisitSeries.Sum().ToString("N0") đ
                    </span>
                </div>
                <div class="chart-holder-main">
                    <canvas id="monthlyRevenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- BOTTOM ROW -->
    <div class="row g-3">

        <!-- TOP SẢN PHẨM BÁN CHẠY -->
        <div class="col-xl-6">
            <div class="dash-box h-100">
                <div class="dash-box-header">
                    <h5 class="dash-box-title">
                        <i class="ti ti-trophy me-2"></i>
                        Top sản phẩm bán chạy — Tháng @Model.SelectedMonth/@Model.SelectedYear
                    </h5>
                </div>
                <div class="simple-list">
                    @if (!Model.BrowserStats.Any())
                    {
                        <div class="empty-state">
                            <i class="ti ti-mood-empty"></i>
                            <p>Chưa có dữ liệu trong tháng này</p>
                        </div>
                    }
                    else
                    {
                        int rank = 1;
                        foreach (var item in Model.BrowserStats)
                        {
                            <div class="simple-row">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rank-badge rank-@(rank <= 3 ? rank.ToString() : "other")">@rank</span>
                                    <span class="product-name" title="@item.Name">@item.Name</span>
                                </div>
                                <strong class="text-primary">@item.Value sp</strong>
                            </div>
                            rank++;
                        }
                    }
                </div>
            </div>
        </div>

        <!-- DOANH THU 7 NGÀY GẦN NHẤT -->
        <div class="col-xl-6">
            <div class="dash-box h-100">
                <div class="dash-box-header">
                    <h5 class="dash-box-title">
                        <i class="ti ti-calendar-stats me-2"></i>
                        Doanh thu 7 ngày gần nhất
                    </h5>
                    <span class="badge-revenue">
                        Tổng: @Model.Last7DaysRevenue.Sum().ToString("N0") đ
                    </span>
                </div>
                <div class="simple-list">
                    @if (!Model.Last7DaysLabels.Any())
                    {
                        <div class="empty-state">
                            <i class="ti ti-mood-empty"></i>
                            <p>Chưa có dữ liệu</p>
                        </div>
                    }
                    else
                    {
                        var maxRevenue = Model.Last7DaysRevenue.Any() ? Model.Last7DaysRevenue.Max() : 1;
                        for (int i = 0; i < Model.Last7DaysLabels.Count; i++)
                        {
                            var revenue  = Model.Last7DaysRevenue[i];
                            var orderCnt = Model.Last7DaysOrderCounts[i];
                            var barWidth = maxRevenue > 0 ? (int)(revenue / maxRevenue * 100) : 0;

                            <div class="simple-row">
                                <div class="d-flex align-items-center gap-2" style="min-width:110px;">
                                    <span class="date-label">@Model.Last7DaysLabels[i]</span>
                                    <span class="order-count-badge">@orderCnt đơn</span>
                                </div>
                                <div class="revenue-bar-wrap">
                                    <div class="revenue-bar" style="width:@(barWidth)%"></div>
                                </div>
                                <strong class="revenue-val">@revenue.ToString("N0") đ</strong>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .analytics-page { animation: riseIn .35s ease; }

    /* ===== FILTER ===== */
    .filter-select {
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        font-size: 13px;
        min-width: 110px;
    }

    .btn-filter {
        background: linear-gradient(135deg, #1a1a2e, #0f3460);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        transition: opacity .15s;
    }

    .btn-filter:hover { opacity: .88; color: #fff; }

    /* ===== KPI ===== */
    .kpi-box {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px 20px;
        border-radius: 14px;
        color: #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        transition: transform .2s;
    }

    .kpi-box:hover { transform: translateY(-3px); }

    .kpi-icon {
        width: 52px; height: 52px;
        background: rgba(255,255,255,0.18);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .kpi-icon i { font-size: 1.6rem; }

    .kpi-content p { margin: 0 0 4px; font-size: 13px; opacity: .85; }
    .kpi-content h3 { margin: 0; font-size: 1.4rem; font-weight: 700; }

    .kpi-gold  { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .kpi-blue  { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
    .kpi-green { background: linear-gradient(135deg, #10b981, #059669); }
    .kpi-dark  { background: linear-gradient(135deg, #1a1a2e, #0f3460); }

    /* ===== DASH BOX ===== */
    .dash-box {
        background: #fff;
        border-radius: 14px;
        padding: 20px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .dash-box-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #f1f5f9;
    }

    .dash-box-title {
        font-weight: 700;
        font-size: 15px;
        color: #0f172a;
        margin: 0;
        display: flex;
        align-items: center;
    }

    .dash-box-title i { color: #0f3460; }

    .badge-revenue {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
        border-radius: 999px;
        padding: 4px 14px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* ===== CHART ===== */
    .chart-holder-main { height: 300px; position: relative; }

    /* ===== LIST ===== */
    .simple-list {
        max-height: 300px;
        overflow-y: auto;
        scrollbar-width: thin;
    }

    .simple-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 4px;
        border-bottom: 1px dashed #f1f5f9;
        font-size: 14px;
        transition: background .15s;
    }

    .simple-row:last-child { border-bottom: none; }
    .simple-row:hover { background: #f8fafc; border-radius: 8px; }

    .product-name {
        color: #374151;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 200px;
    }

    /* ===== REVENUE BAR ===== */
    .revenue-bar-wrap {
        flex: 1;
        margin: 0 12px;
        background: #f1f5f9;
        border-radius: 999px;
        height: 8px;
        overflow: hidden;
    }

    .revenue-bar {
        height: 100%;
        background: linear-gradient(90deg, #0f3460, #2563eb);
        border-radius: 999px;
        transition: width .4s ease;
        min-width: 2px;
    }

    .revenue-val {
        color: #0f3460;
        font-size: 13px;
        white-space: nowrap;
        min-width: 120px;
        text-align: right;
    }

    .date-label {
        color: #374151;
        font-weight: 600;
        font-size: 13px;
        white-space: nowrap;
    }

    .order-count-badge {
        background: #eff6ff;
        color: #1d4ed8;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* ===== RANK BADGE ===== */
    .rank-badge {
        width: 24px; height: 24px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center; justify-content: center;
        font-size: 12px; font-weight: 700;
        flex-shrink: 0;
    }

    .rank-1     { background: #fef3c7; color: #d97706; }
    .rank-2     { background: #f1f5f9; color: #64748b; }
    .rank-3     { background: #fff7ed; color: #c2410c; }
    .rank-other { background: #f8fafc; color: #94a3b8; }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        color: #94a3b8;
        font-size: 14px;
        gap: 8px;
    }

    .empty-state i { font-size: 2rem; }
    .empty-state p { margin: 0; }

    @@keyframes riseIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyVisitLabels));
    const series = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyVisitSeries));

    const ctx = document.getElementById('monthlyRevenueChart').getContext('2d');

    const gradient = ctx.createLinearGradient(0, 0, 0, 300);
    gradient.addColorStop(0, 'rgba(245,158,11,0.35)');
    gradient.addColorStop(1, 'rgba(245,158,11,0.01)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Doanh thu (đ)',
                data: series,
                borderColor: '#f59e0b',
                backgroundColor: gradient,
                borderWidth: 2.5,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#f59e0b',
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 7
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#1a1a2e',
                    titleColor: '#fff',
                    bodyColor: '#cbd5e1',
                    padding: 12,
                    cornerRadius: 10,
                    callbacks: {
                        label: ctx => ' ' + ctx.parsed.y.toLocaleString('vi-VN') + ' đ'
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: {
                        font: { size: 11 },
                        color: '#94a3b8',
                        maxTicksLimit: 15
                    }
                },
                y: {
                    grid: { color: '#f1f5f9' },
                    ticks: {
                        font: { size: 11 },
                        color: '#94a3b8',
                        callback: val => val.toLocaleString('vi-VN') + ' đ'
                    }
                }
            }
        }
    });
</script>