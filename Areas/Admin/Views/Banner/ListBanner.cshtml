@model List<LapTopBD.ViewModels.BannerViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Banner";
}

<style>
    /* --- HỆ THỐNG ĐÈ CSS THU GỌN BẢNG TUYỆT ĐỐI --- */
    .custom-table-wrapper {
        background-color: #ffffff;
        border: 1px solid #e3e6f0;
        width: 100% !important;
        overflow-x: auto !important; /* Đảm bảo vẫn cuộn mượt mà trên mobile */
        -webkit-overflow-scrolling: touch;
    }

        /* Ép bảng chỉ rộng bằng vừa khít nội dung các cột cộng lại, không cho phép chiếm 100% màn hình PC */
        .custom-table-wrapper table.compact-table {
            width: max-content !important;
            min-width: 100% !important;
            table-layout: auto !important;
            border-collapse: collapse !important;
            margin-bottom: 0 !important;
        }

        /* Padding trung gian vừa vặn giữa các cột */
        .custom-table-wrapper .compact-table th,
        .custom-table-wrapper .compact-table td {
            padding: 12px 20px !important;
            vertical-align: middle !important;
            white-space: nowrap !important; /* Giữ chữ trên một dòng để tính max-content chuẩn xác */
        }

        /* Giới hạn riêng cột tiêu đề để nó không giãn quá rộng */
        .custom-table-wrapper .compact-table .col-title {
            width: 250px !important;
            min-width: 200px !important;
            max-width: 300px !important;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    /* Định dạng ảnh đại diện banner */
    .banner-thumb {
        width: 120px !important;
        height: auto;
        object-fit: cover;
        border-radius: 6px;
    }

    /* Các nút hành động nhỏ gọn */
    .action .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 35px;
        height: 35px;
        padding: 0;
        border-radius: 6px;
        font-size: 1rem;
        transition: all 0.2s ease;
    }

    /* --- GIAO DIỆN KHU VỰC CHỌN ẢNH (MODAL) --- */
    .modal-body .form-group,
    .modal-body .banner-group {
        margin-bottom: 15px;
    }

    .modal-body label {
        font-weight: 600;
        margin-bottom: 5px;
        color: #333;
    }

    .banner-upload-area {
        position: relative;
        border: 2px dashed #d1d3e2;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        background: #f8f9fc;
        cursor: pointer;
        transition: all 0.2s ease;
        min-height: 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .banner-upload-area:hover {
            border-color: #4e73df;
            background: #f0f2f9;
        }

    .banner-file-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .banner-upload-hint i {
        font-size: 2.2rem;
        color: #858796;
    }

    .banner-image-preview {
        max-width: 100%;
        max-height: 100px;
        object-fit: contain;
        border-radius: 6px;
        margin-top: 5px;
    }

        .banner-image-preview.hidden {
            display: none !important;
        }

    /* --- RESPONSIVE DÀNH RIÊNG CHO MOBILE --- */
    @@media (max-width: 767.98px) {
        h1.text-center {
            font-size: 1.6rem !important;
            margin-top: 15px !important;
            margin-bottom: 15px !important;
        }

        .custom-btn-add {
            width: 100%;
            padding: 10px;
            font-weight: 600;
        }
    }
</style>

<h1 class="text-center my-4 fw-bold text-dark">Quản lý Banner</h1>

<div class="mb-3">
    <button class="btn btn-primary custom-btn-add px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addBannerModal">
        <i class="ri-add-box-line me-1"></i> Thêm Banner
    </button>
</div>

<div class="modal fade" id="addBannerModal" tabindex="-1" aria-labelledby="addBannerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addBannerModalLabel">Thêm Banner Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addBannerForm" enctype="multipart/form-data">
                    <input type="hidden" id="bannerId" name="Id" value="0" />

                    <div class="form-group">
                        <label for="bannerTitle">Tiêu đề</label>
                        <input type="text" class="form-control" id="bannerTitle" name="Title" placeholder="Nhập tiêu đề banner..." required>
                    </div>

                    <div class="banner-group">
                        <label for="bannerImage">Hình ảnh</label>
                        <div class="banner-upload-area shadow-sm">
                            <input type="file" class="banner-file-input" id="bannerImage" name="ImageFile" accept="image/*">
                            <span class="banner-upload-hint">
                                <i class="ri-image-add-fill"></i>
                            </span>
                            <img id="bannerPreview" class="banner-image-preview hidden" src="#" alt="Ảnh xem trước">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="bannerStatus">Trạng thái</label>
                        <select class="form-control form-select" id="bannerStatus" name="Status">
                            <option value="true">Hiển thị</option>
                            <option value="false">Ẩn</option>
                        </select>
                    </div>

                    <div class="modal-footer px-0 pb-0 mt-4">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-primary" id="saveBannerBtn">Lưu lại</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="custom-table-wrapper shadow-sm rounded-3">
    <table id="sortable" class="table table-hover align-middle compact-table">
        <thead class="table-primary">
            <tr>
                <th scope="col" style="width: 160px;">Hình ảnh</th>
                <th scope="col" class="col-title">Tiêu đề</th>
                <th scope="col" class="text-center" style="width: 120px;">Trạng thái</th>
                <th scope="col" class="text-center" style="width: 90px;">Vị trí</th>
                <th scope="col" class="text-center" style="width: 120px;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var banner in Model)
            {
                <tr data-id="@banner.Id">
                    <td>
                        <img src="@banner.ImageUrl" alt="@banner.Title" class="banner-thumb drag-handle img-thumbnail shadow-sm" />
                    </td>
                    <td class="col-title">
                        <span class="fw-bold text-dark">@banner.Title</span>
                    </td>
                    <td class="status text-center">
                        @if (banner.Status)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1.5 rounded">Hiển thị</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1.5 rounded">Ẩn</span>
                        }
                    </td>
                    <td class="create-date text-center">
                        <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-bold">@banner.Position</span>
                    </td>
                    <td class="action text-center">
                        <a href="@Url.Action("EditBanner", "Banner", new { id = banner.Id })" class="btn btn-action btn-outline-primary me-1" title="Sửa">
                            <i class="ri-pencil-line"></i>
                        </a>
                        <a href="javascript:void(0);" class="delete-banner btn btn-action btn-outline-danger" data-id="@banner.Id" title="Xóa">
                            <i class="ri-delete-bin-6-line"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3" id="message"></div>