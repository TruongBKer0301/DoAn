@model LapTopBD.Models.BlogPost

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Sửa bài viết blog";
}

<div class="row justify-content-center">
    <div class="col-xl-10">

        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    Chỉnh sửa bài viết
                </h5>

                <a class="btn btn-light"
                   asp-area="Admin"
                   asp-controller="Blog"
                   asp-action="Index">
                    Quay lại
                </a>
            </div>

            <div class="card-body">

                <form asp-area="Admin"
                      asp-controller="Blog"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- TITLE -->
                    <div class="mb-3">

                        <label asp-for="Title"
                               class="form-label">
                            Tiêu đề
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               maxlength="200"
                               placeholder="Nhập tiêu đề bài viết" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- SUMMARY -->
                    <div class="mb-3">

                        <label asp-for="Summary"
                               class="form-label">
                            Tóm tắt ngắn
                        </label>

                        <textarea asp-for="Summary"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Nhập mô tả ngắn"></textarea>

                        <span asp-validation-for="Summary"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- IMAGE URL -->
                    <div class="mb-3">

                        <label asp-for="CoverImageUrl"
                               class="form-label">
                            Ảnh đại diện (URL)
                        </label>

                        <input asp-for="CoverImageUrl"
                               class="form-control"
                               maxlength="300"
                               placeholder="https://..." />

                        <span asp-validation-for="CoverImageUrl"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- CURRENT IMAGE -->
                    @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                    {
                        <div class="mb-3">

                            <label class="form-label d-block">
                                Ảnh hiện tại
                            </label>

                            <img src="@Model.CoverImageUrl"
                                 class="img-fluid rounded border"
                                 style="max-height:260px;object-fit:cover;" />

                        </div>
                    }

                    <!-- UPLOAD -->
                    <div class="mb-3">

                        <label class="form-label">
                            Hoặc upload ảnh mới
                        </label>

                        <input type="file"
                               name="CoverImageFile"
                               class="form-control"
                               accept="image/*" />

                        <small class="text-muted">
                            Nếu upload ảnh mới, hệ thống sẽ thay thế ảnh cũ.
                        </small>

                    </div>

                    <!-- CONTENT -->
                    <div class="mb-3">

                        <label asp-for="ContentHtml"
                               class="form-label">
                            Nội dung
                        </label>

                        <textarea asp-for="ContentHtml"
                                  id="blogEditor"
                                  class="form-control"
                                  rows="14"
                                  placeholder="Nhập nội dung bài viết"></textarea>

                        <span asp-validation-for="ContentHtml"
                              class="text-danger">
                        </span>

                        <small class="text-muted d-block mt-2">
                            Trình soạn thảo CKEditor hỗ trợ đầy đủ toolbar.
                        </small>

                    </div>

                    <!-- PUBLISH -->
                    <div class="form-check form-switch mb-4">

                        <input asp-for="IsPublished"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="IsPublished"
                               class="form-check-label">
                            Đăng bài ngay
                        </label>

                    </div>

                    <!-- BUTTON -->
                    <div class="d-flex justify-content-end gap-2">

                        <a class="btn btn-light"
                           asp-action="Index">
                            Hủy
                        </a>

                        <button type="submit"
                                class="btn btn-primary">
                            Cập nhật bài viết
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- CKEDITOR -->
    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>

    <script>

        let editor;

        document.addEventListener("DOMContentLoaded", function () {

            ClassicEditor
                .create(document.querySelector('#blogEditor'))
                .then(newEditor => {

                    editor = newEditor;

                    // chiều cao editor
                    newEditor.ui.view.editable.element.style.minHeight = '400px';

                    // submit form
                    const form = document.querySelector('form');

                    form.addEventListener('submit', function () {

                        document.querySelector('#blogEditor').value =
                            editor.getData();

                    });

                })
                .catch(error => {
                    console.error(error);
                });

        });

    </script>
}