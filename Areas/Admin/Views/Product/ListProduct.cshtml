@model List<LapTopBD.ViewModels.ProductViewModel>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh sách Sản Phẩm";
}

<style>
    /* --- CẤU TRÚC BẢNG RESPONSIVE --- */
    .custom-table-wrapper {
        background-color: #ffffff;
        border: 1px solid #e3e6f0;
        width: 100% !important;
        overflow-x: auto !important; /* Cuộn ngang mượt mà trên mobile */
        -webkit-overflow-scrolling: touch;
    }

        .custom-table-wrapper table {
            width: 100% !important;
            min-width: 1000px !important; /* Đảm bảo đủ không gian hiển thị thông tin sản phẩm */
            table-layout: auto !important;
        }

        .custom-table-wrapper .table th,
        .custom-table-wrapper .table td {
            padding: 12px 10px !important;
            vertical-align: middle;
            white-space: nowrap !important;
        }

    /* Thiết lập ảnh thumbnail gọn gàng trong bảng */
    .product-img-thumb {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 6px;
    }

    /* Khối nút hành động */
    .action .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 35px;
        height: 35px;
        padding: 0;
        border-radius: 6px;
        font-size: 1rem;
        transition: all 0.2s ease;
    }

    /* --- CẤU TRÚC MODAL & UPLOAD BOX --- */
    .modal-body .form-group {
        margin-bottom: 12px;
    }

        .modal-body .form-group label {
            font-weight: 600;
            margin-bottom: 4px;
            color: #333;
        }

    /* Ô upload ảnh thiết kế trực quan */
    .upload-box {
        position: relative;
        border: 2px dashed #d1d3e2;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        background: #f8f9fc;
        cursor: pointer;
        transition: all 0.2s ease;
        min-height: 110px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .upload-box:hover {
            border-color: #4e73df;
            background: #f0f2f9;
        }

        .upload-box input[type="file"] {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
        }

        .upload-box .upload-instruction i {
            font-size: 2rem;
            color: #858796;
        }

        .upload-box .img-preview {
            max-height: 80px;
            object-fit: contain;
            border-radius: 4px;
        }

    /* --- CSS RESPONSIVE CHO DI ĐỘNG --- */
    @@media (max-width: 767.98px) {
        h1.text-center {
            font-size: 1.6rem !important;
            margin-top: 15px !important;
            margin-bottom: 15px !important;
        }

        .custom-btn-add {
            width: 100%; /* Nút thêm tràn màn hình trên điện thoại */
            padding: 10px;
            font-weight: 600;
        }

        .upload-box {
            margin-bottom: 15px; /* Tạo khoảng cách các ô ảnh khi bị đẩy xếp dọc */
        }
    }
</style>

<h1 class="text-center my-4 fw-bold text-dark">Danh sách Sản Phẩm</h1>

<div class="mb-3">
    <button id="addProductBtn" class="btn btn-primary custom-btn-add px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addProductModal">
        <i class="ri-add-box-line me-1"></i> Thêm Sản Phẩm
    </button>
</div>

<div class="modal fade" id="addProductModal" tabindex="-1" role="dialog" aria-labelledby="addProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-sm-down" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addProductModalLabel">Thêm Sản Phẩm Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addProductForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ProductName">Tên sản phẩm</label>
                                <input type="text" class="form-control" id="ProductName" required />
                            </div>

                            <div class="form-group">
                                <label for="CategoryId">Danh mục</label>
                                <select class="form-control form-select" id="CategoryId" required>
                                    <option value="">-- Chọn danh mục --</option>
                                    @foreach (var category in ViewBag.Categories)
                                    {
                                        <option value="@category.Id">@category.CategoryName</option>
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="SubCategoryId">Danh mục phụ</label>
                                <select class="form-control form-select" id="SubCategoryId">
                                    <option value="">-- Chọn danh mục phụ --</option>
                                </select>
                            </div>

                            <div class="row">
                                <div class="col-6">
                                    <div class="form-group">
                                        <label for="ProductPrice">Giá bán</label>
                                        <input type="number" class="form-control" id="ProductPrice" required />
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="form-group">
                                        <label for="ProductPriceBeforeDiscount">Giá gốc</label>
                                        <input type="number" class="form-control" id="ProductPriceBeforeDiscount" />
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="ProductAvailability">Số lượng</label>
                                <input type="number" class="form-control" id="quantity" required />
                            </div>
                            <div class="form-group">
                                <label for="Promotion">Khuyến mãi</label>
                                <input type="text" class="form-control" id="Promotion" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-6 col-sm-4 col-md-6">
                                    <div class="form-group"><label for="Brand">Hãng</label><input type="text" class="form-control" id="Brand" /></div>
                                </div>
                                <div class="col-6 col-sm-4 col-md-6">
                                    <div class="form-group"><label for="CPU">CPU</label><input type="text" class="form-control" id="CPU" /></div>
                                </div>
                                <div class="col-6 col-sm-4 col-md-6">
                                    <div class="form-group"><label for="RAM">RAM</label><input type="text" class="form-control" id="RAM" /></div>
                                </div>
                                <div class="col-6 col-sm-4 col-md-6">
                                    <div class="form-group"><label for="Storage">Ổ cứng</label><input type="text" class="form-control" id="Storage" /></div>
                                </div>
                                <div class="col-6 col-sm-4 col-md-6">
                                    <div class="form-group"><label for="GPU">GPU</label><input type="text" class="form-control" id="GPU" /></div>
                                </div>
                                <div class="col-6 col-sm-4 col-md-6">
                                    <div class="form-group"><label for="VGA">Card màn hình</label><input type="text" class="form-control" id="VGA" /></div>
                                </div>
                                <div class="col-6 col-sm-4 col-md-6">
                                    <div class="form-group"><label for="PIN">Pin</label><input type="text" class="form-control" id="PIN" /></div>
                                </div>
                                <div class="col-6 col-sm-4 col-md-6">
                                    <div class="form-group"><label for="WEIGHT">Trọng lượng</label><input type="text" class="form-control" id="WEIGHT" /></div>
                                </div>
                                <div class="col-12 col-sm-4 col-md-12">
                                    <div class="form-group"><label for="SIZE">Kích thước</label><input type="text" class="form-control" id="SIZE" /></div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="BONUS">Thông tin bổ sung</label>
                                <input type="text" class="form-control" id="BONUS" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="ProductDescription">Mô tả</label>
                                <textarea class="form-control" id="editor" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Ảnh 1 (Đại diện)</label>
                                <div class="upload-box shadow-sm">
                                    <input type="file" class="form-control-file file-input" id="ProductImage1">
                                    <span class="upload-instruction"><i class="ri-image-add-fill"></i></span>
                                    <img src="#" class="img-preview d-none">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Ảnh 2</label>
                                <div class="upload-box shadow-sm">
                                    <input type="file" class="form-control-file file-input" id="ProductImage2">
                                    <span class="upload-instruction"><i class="ri-image-add-fill"></i></span>
                                    <img src="#" class="img-preview d-none">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Ảnh 3</label>
                                <div class="upload-box shadow-sm">
                                    <input type="file" class="form-control-file file-input" id="ProductImage3">
                                    <span class="upload-instruction"><i class="ri-image-add-fill"></i></span>
                                    <img src="#" class="img-preview d-none">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-2" id="message"></div>
                    <div class="modal-footer px-0 pb-0 mt-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-primary" id="saveNewProductBtn">Thêm Sản Phẩm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive shadow-sm custom-table-wrapper rounded-3">
    <table class="table table-hover align-middle mb-0" id="productTable">
        <thead class="table-primary">
            <tr class="text-nowrap">
                <th scope="col" class="text-center" style="width: 90px;">Ảnh</th>
                <th scope="col">Tên sản phẩm</th>
                <th scope="col">Danh mục</th>
                <th scope="col">Số lượng</th>
                <th scope="col">Giá bán</th>
                <th scope="col">Giá gốc</th>
                <th scope="col" class="text-center" style="width: 110px;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td class="text-center">
                        <a class="elem" href="@product.ProductImage1" title="@product.ProductName - Ảnh 1"
                           data-lcl-thumb="@product.ProductImage1" rel="product-@product.Id">
                            <img src="@product.ProductImage1" alt="Product Image" class="product-img-thumb img-thumbnail shadow-sm">
                        </a>

                        @if (!string.IsNullOrEmpty(product.ProductImage2))
                        {
                            <a class="elem hidden-images" href="@product.ProductImage2" title="@product.ProductName - Ảnh 2"
                               data-lcl-thumb="@product.ProductImage2" rel="product-@product.Id"></a>
                        }
                        @if (!string.IsNullOrEmpty(product.ProductImage3))
                        {
                            <a class="elem hidden-images" href="@product.ProductImage3" title="@product.ProductName - Ảnh 3"
                               data-lcl-thumb="@product.ProductImage3" rel="product-@product.Id"></a>
                        }
                    </td>
                    <td class="text-nowrap"><span class="fw-bold text-dark">@product.ProductName</span></td>
                    <td class="text-secondary">@product.CategoryName</td>
                    <td class="text-dark fw-bold">@product.quantity</td>
                    <td class="text-primary fw-bold">@product.ProductPrice.ToString("N0") đ</td>
                    <td class="text-muted">
                        @(product.ProductPriceBeforeDiscount.HasValue? product.ProductPriceBeforeDiscount.Value.ToString("N0") + " đ" : "—")
                    </td>
                    <td class="action text-center">
                        <a href="@Url.Action("EditProduct", "Product", new { id = product.Id })" class="btn btn-action btn-outline-primary me-1" title="Sửa">
                            <i class="ri-pencil-line"></i>
                        </a>
                        <a href="javascript:void(0);" class="delete-product btn btn-action btn-outline-danger" data-id="@product.Id" title="Xóa">
                            <i class="ri-delete-bin-6-line"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3" id="message"></div>

@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="d-flex justify-content-center mt-4">
        <ul class="pagination shadow-sm">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("ListProduct", new { page = 1 })">&laquo;&laquo;</a>
            </li>
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("ListProduct", new { page = ViewBag.CurrentPage - 1 })">&laquo;</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                if (i <= 3 || i == ViewBag.TotalPages || (i >= ViewBag.CurrentPage - 1 && i <= ViewBag.CurrentPage + 1))
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("ListProduct", new { page = i })">@i</a>
                    </li>
                }
                else if (i == 4 && ViewBag.CurrentPage > 3)
                {
                    <li class="page-item disabled"><a class="page-link">...</a></li>
                }
                else if (i == ViewBag.TotalPages - 1 && ViewBag.CurrentPage < ViewBag.TotalPages - 3)
                {
                    <li class="page-item disabled"><a class="page-link">...</a></li>
                }
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("ListProduct", new { page = ViewBag.CurrentPage + 1 })">&raquo;</a>
            </li>
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("ListProduct", new { page = ViewBag.TotalPages })">&raquo;&raquo;</a>
            </li>
        </ul>
    </nav>
}