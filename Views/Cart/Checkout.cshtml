@model LapTopBD.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container mt-5">
    <h2 class="mb-4">Thanh toán</h2>

    <div id="message"></div>

    <div class="row">
        <!-- FORM -->
        <div class="col-lg-6">
            <form id="checkoutForm">

                @if (Model?.SelectedProductIds != null)
                {
                    foreach (var id in Model.SelectedProductIds)
                    {
                        <input type="hidden" name="SelectedProductIds" value="@id" />
                    }
                }

                <div class="mb-3">
                    <label>Họ tên</label>
                    <input type="text" class="form-control" name="Name" required />
                </div>

                <div class="mb-3">
                    <label>Số điện thoại</label>
                    <input type="text" class="form-control" name="ContactNo" id="phone" required />
                    <small id="phoneError" class="text-danger"></small>
                </div>

                <!-- ADDRESS -->
                <!-- ADDRESS DROPDOWN (NO GOOGLE MAP) -->

                <div class="custom-form-group">
                    <label>Tỉnh/Thành <span class="text-danger">*</span></label>
                    <select id="province" name="City" class="custom-select" required></select>
                </div>

                <div class="custom-form-group">
                    <label>Xã/Phường <span class="text-danger">*</span></label>
                    <select id="commune" name="Ward" class="custom-select" required></select>
                </div>

                <div class="custom-form-group">
                    <label>Địa chỉ cụ thể <span class="text-danger">*</span></label>
                    <input type="text" id="addressDetail" name="Address" class="custom-input" required />
                </div>
                <script>
                                    const API_BASE = "/api/address";

                                    // Load tỉnh (value = province code)
                                    async function loadProvinces() {
                                        try {
                                            let res = await fetch(`${API_BASE}/provinces`);
                                            if (!res.ok) throw new Error(`HTTP ${res.status}`);
                                            let data = await res.json();
                                            let provinces = Array.isArray(data) ? data : [];

                                            let html = '<option value="">-- Chọn tỉnh --</option>';
                                            provinces.forEach(p => {
                                                const code = p.code || "";
                                                const name = p.name || "";
                                                html += `<option value="${name}" data-code="${code}">${name}</option>`;
                                            });

                                            document.getElementById("province").innerHTML = html;                                        } catch (err) {
                                            console.error("Lỗi load tỉnh:", err);
                                        }
                                    }

                                    // Load xã/phường by province code
                                    async function loadCommunes(provinceCode) {
                                        if (!provinceCode) {
                                            document.getElementById("commune").innerHTML = '<option value="">-- Chọn xã/phường --</option>';
                                            return;
                                        }

                                        try {
                                            let res = await fetch(`${API_BASE}/provinces/${provinceCode}/communes`);
                                            if (!res.ok) throw new Error(`HTTP ${res.status}`);
                                            let data = await res.json();
                                            let communes = Array.isArray(data) ? data : [];

                                            let html = '<option value="">-- Chọn xã/phường --</option>';
                                            communes.forEach(c => {
                                                const name = c.name || "";
                                                const code = c.code || "";
                                                const districtName = c.districtName || "";
                                                html += `<option value="${name}" data-code="${code}" data-district="${districtName}">${name}</option>`;
                                            });

                                            document.getElementById("commune").innerHTML = html;                                        } catch (err) {
                                            console.error("Lỗi load xã:", err);
                                        }
                                    }

                                    // Event change tỉnh
                                    document.getElementById("province").addEventListener("change", function (e) {
                                        const selected = e.target.options[e.target.selectedIndex];
                                        const provinceCode = selected ? selected.dataset.code : "";
                                        loadCommunes(provinceCode);
                                    });

                                    // Init
                                    document.addEventListener("DOMContentLoaded", async function () {
                                        await loadProvinces();
                                    });
                </script>


                <div class="mb-3">
                    <label>Thanh toán</label>
                    <select class="form-control" name="PaymentMethod" required>
                        <option value="">-- Chọn --</option>
                        <option value="COD">COD</option>
                        <option value="VNPAY">VNPay</option>
                    </select>
                </div>

                <button type="button" class="btn btn-primary w-100" onclick="submitCheckout()">Đặt hàng</button>
            </form>
        </div>

        <!-- ORDER SUMMARY -->
        <div class="col-lg-6">
            <h3 class="mb-4">Thông tin đơn hàng</h3>
            <table class="custom-table">
                <thead class="custom-table-head">
                    <tr>
                        <th>Ảnh sản phẩm</th>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Giá</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CartItems)
                    {
                        <tr class="custom-table-row">
                            <td><img width="150" src="@item.ProductImage" /></td>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td class="custom-price">@item.ProductPrice.ToString("N0") VNĐ</td>
                            <td class="custom-total">@item.Subtotal.ToString("N0") VNĐ</td>
                        </tr>
                        <tr>
                            <td colspan="5">
                                <div class="text-danger product-error" id="error-@item.ProductId"></div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4">Tổng cộng</td>
                        <td class="custom-total" id="totalAmount">@Model.TotalPrice.ToString("N0") VNĐ</td>
                    </tr>
                </tfoot>
            </table>
            <button type="button" class="custom-btn custom-btn-block" onclick="submitCheckout()">Đặt hàng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // =========================
        // VALIDATE PHONE VN
        // =========================
        function validatePhoneVN(phone) {
            const regex = /^(0|\+84)(3|5|7|8|9)[0-9]{8}$/;
            return regex.test(phone);
        }

        $('#phone').on('blur', function () {
            const phone = $(this).val().trim();
            if (!validatePhoneVN(phone)) {
                $('#phoneError').text("SĐT không hợp lệ (VD: 098xxxxxxx)");
            } else {
                $('#phoneError').text("");
            }
        });

        // =========================
        // SUBMIT
        // =========================
        function submitCheckout() {
            const data = {
                Name: $('input[name="Name"]').val()?.trim() || '',
                ContactNo: $('input[name="ContactNo"]').val()?.trim() || '',
                City: $('#province option:selected').text().trim(),
                Ward: $('#commune option:selected').text().trim(),
                Address: $('input[name="Address"]').val()?.trim() || '',
                PaymentMethod: $('select[name="PaymentMethod"]').val()?.trim() || ''
            };

            // VALIDATE
            if (!validatePhoneVN(data.ContactNo)) {
                showMessage("Số điện thoại không hợp lệ!", "danger");
                return;
            }

            if (!data.City || !data.Ward) {
                showMessage("Vui lòng chọn đầy đủ địa chỉ!", "danger");
                return;
            }

            // Get selected items from cart selection (hidden inputs)
            const selectedItems = $('input[name="SelectedProductIds"]').map(function () {
                return $(this).val();
            }).get();

            if (selectedItems.length === 0) {
                showMessage("Vui lòng chọn ít nhất 1 sản phẩm để thanh toán!", "danger");
                return;
            }

            // Add selected items to data
            data.SelectedProductIds = selectedItems.map(id => parseInt(id, 10)).filter(id => !Number.isNaN(id));

            $.ajax({
                url: '@Url.Action("Checkout", "Cart")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (res) {
                    if (res.success) {
                        if (data.PaymentMethod === "COD") {
                            alert("Đặt hàng thành công!");
                            window.location.href = "/";
                        } else {
                            window.location.href = res.redirectUrl;
                        }
                    } else {
                        showMessage(res.message, "danger");
                    }
                }
            });
        }

        function showMessage(msg, type) {
            $('#message').html(`<div class="alert alert-${type}">${msg}</div>`);
        }
    </script>
}