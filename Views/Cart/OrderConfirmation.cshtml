@model List<LapTopBD.Models.Order>
@{
    ViewData["Title"] = "Xác nhận đơn hàng";
}

<!-- Page Header Start -->
<div class="container-fluid hero-order-confirm mb-5">
    <div class="hero-inner">
        <div class="hero-badge">
            <i class="ti ti-shield-check"></i>
            <span>Đảm bảo an toàn</span>
        </div>
        <h1 class="hero-title">Xác nhận đơn hàng</h1>
        <div class="hero-divider"></div>
        <div class="hero-breadcrumb">
            <a href="@Url.Action("Index", "Home")">Trang Chủ >></a>
            <i class="ti ti-chevron-right"></i>
            <span class="hero-breadcrumb-current">Xác nhận đơn hàng</span>
        </div>
    </div>
</div>
<!-- Page Header End -->

    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="thank-you-banner mb-4">
        <i class="ti ti-circle-check thank-you-icon"></i>
        <div>
            <h3 class="thank-you-title">Cảm ơn bạn đã đặt hàng!</h3>
            <p class="thank-you-sub">Đơn hàng của bạn đang được xử lý. Chúng tôi sẽ liên hệ sớm nhất có thể.</p>
        </div>
    </div>

    <div class="custom-table-container table-responsive">
        <table class="custom-table">
            <thead class="custom-table-head">
                <tr>
                    <th>Mã đơn hàng</th>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Tổng tiền</th>
                    <th>Phương thức thanh toán</th>
                    <th>Trạng thái</th>
                    <th>Ngày đặt</th>
                    <th>Hủy đơn</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr class="custom-table-row" data-order-id="@order.Id">
                        <td><span class="order-id-badge">#@order.Id</span></td>
                        <td class="product-name-cell">@order.Product.ProductName</td>
                        <td class="text-center">@order.Quantity</td>
                        <td class="custom-total">@order.TotalPrice.ToString("N0")Đ</td>
                        <td>
                            @if (order.PaymentMethod == "COD")
                            {
                                <span class="payment-badge payment-cod">
                                    <i class="ti ti-cash"></i> COD
                                </span>
                            }
                            else
                            {
                                <span class="payment-badge payment-online">
                                    <i class="ti ti-credit-card"></i> @order.PaymentMethod
                                </span>
                            }
                        </td>
                        <td class="order-status">
                            @if (order.OrderStatus == "Pending")
                            {
                                <span class="status-badge status-pending">
                                    <i class="ti ti-clock"></i> Chờ xử lý
                                </span>
                            }
                            else if (order.OrderStatus == "Processing")
                            {
                                <span class="status-badge status-processing">
                                    <i class="ti ti-loader"></i> Đang xử lý
                                </span>
                            }
                            else if (order.OrderStatus == "Shipped")
                            {
                                <span class="status-badge status-shipped">
                                    <i class="ti ti-truck"></i> Đang giao
                                </span>
                            }
                            else if (order.OrderStatus == "Delivered")
                            {
                                <span class="status-badge status-delivered">
                                    <i class="ti ti-circle-check"></i> Đã giao
                                </span>
                            }
                            else if (order.OrderStatus == "Cancelled")
                            {
                                <span class="status-badge status-cancelled">
                                    <i class="ti ti-x"></i> Đã hủy
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-default">@order.OrderStatus</span>
                            }
                        </td>
                        <td class="text-nowrap">@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td class="cancel-action">
                            @if (order.OrderStatus == "Pending")
                            {
                                <button class="btn-cancel-order" data-id="@order.Id">
                                    <i class="ti ti-trash"></i> Hủy
                                </button>
                            }
                            else if (order.OrderStatus == "Cancelled")
                            {
                                <span class="cancel-done">
                                    <i class="ti ti-circle-check"></i> Đã hủy
                                </span>
                            }
                            else
                            {
                                <span class="cancel-unavailable">
                                    <i class="ti ti-lock"></i> Không thể hủy
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3" id="message"></div>

    <div class="action-footer">
        <a href="@Url.Action("Index", "Home")" class="btn-continue">
            <i class="ti ti-arrow-left"></i> Tiếp tục mua sắm
        </a>
    </div>
</div>

<style>
    /* ===== HERO ===== */
    .hero-order-confirm {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    }

    .hero-order-confirm::before,
    .hero-order-confirm::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.04);
        pointer-events: none;
    }

    .hero-order-confirm::before {
        width: 300px; height: 300px;
        top: -80px; left: -60px;
    }

    .hero-order-confirm::after {
        width: 400px; height: 400px;
        bottom: -120px; right: -60px;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 240px;
        padding: 3rem 1rem;
        text-align: center;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.08);
        border: 0.5px solid rgba(255, 255, 255, 0.18);
        border-radius: 999px;
        padding: 6px 18px;
        margin-bottom: 1.2rem;
        color: rgba(255, 255, 255, 0.75);
        font-size: 13px;
        letter-spacing: 0.04em;
    }

    .hero-badge i {
        font-size: 15px;
        color: #a8c8ff;
    }

    .hero-title {
        font-size: 2rem;
        font-weight: 600;
        color: #ffffff;
        margin: 0;
        letter-spacing: -0.01em;
        text-transform: uppercase;
    }

    .hero-divider {
        width: 48px;
        height: 2px;
        background: rgba(255, 255, 255, 0.25);
        margin: 1rem auto;
    }

    .hero-breadcrumb {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
    }

    .hero-breadcrumb a {
        color: rgba(255, 255, 255, 0.55);
        text-decoration: none;
        transition: color 0.2s;
    }

    .hero-breadcrumb a:hover { color: rgba(255, 255, 255, 0.85); }

    .hero-breadcrumb i {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.3);
    }

    .hero-breadcrumb-current { color: #f0a0a0; }

    /* ===== CONTAINER ===== */
    .custom-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem 3rem;
    }

    /* ===== THANK YOU BANNER ===== */
    .thank-you-banner {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
    }

    .thank-you-icon {
        font-size: 2.5rem;
        color: #16a34a;
        flex-shrink: 0;
    }

    .thank-you-title {
        margin: 0 0 4px;
        font-size: 1.2rem;
        font-weight: 600;
        color: #15803d;
    }

    .thank-you-sub {
        margin: 0;
        font-size: 14px;
        color: #166534;
    }

    /* ===== TABLE ===== */
    .custom-table-container {
        border-radius: 12px;
        /* Allow the table to expand to show all rows */
        overflow: visible;
        border: 1px solid #e5e7eb;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        background: #fff;
    }

    .custom-table-head tr {
        background: linear-gradient(135deg, #1a1a2e, #0f3460);
    }

    .custom-table-head th {
        color: rgba(255,255,255,0.85);
        font-weight: 500;
        padding: 14px 16px;
        text-align: left;
        white-space: nowrap;
        font-size: 13px;
        letter-spacing: 0.02em;
    }

    .custom-table-row td {
        padding: 14px 16px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        color: #374151;
    }

    .custom-table-row:last-child td { border-bottom: none; }

    .custom-table-row:hover td { background: #f8fafc; }

    /* ===== CELLS ===== */
    .order-id-badge {
        display: inline-block;
        background: #f1f5f9;
        color: #475569;
        border-radius: 6px;
        padding: 3px 10px;
        font-size: 13px;
        font-weight: 600;
    }

    .product-name-cell {
        max-width: 200px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .custom-total {
        font-weight: 700;
        color: #dc2626;
        white-space: nowrap;
    }

    /* ===== PAYMENT BADGES ===== */
    .payment-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 500;
    }

    .payment-cod {
        background: #fef9c3;
        color: #854d0e;
    }

    .payment-online {
        background: #eff6ff;
        color: #1d4ed8;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
    }

    .status-pending    { background: #fef9c3; color: #854d0e; }
    .status-processing { background: #eff6ff; color: #1d4ed8; }
    .status-shipped    { background: #f0fdf4; color: #166534; }
    .status-delivered  { background: #dcfce7; color: #15803d; }
    .status-cancelled  { background: #fef2f2; color: #991b1b; }
    .status-default    { background: #f1f5f9; color: #475569; }

    /* ===== CANCEL ACTIONS ===== */
    .btn-cancel-order {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-cancel-order:hover {
        background: #dc2626;
        color: #fff;
        border-color: #dc2626;
    }

    .cancel-done {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        color: #16a34a;
    }

    .cancel-unavailable {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        color: #9ca3af;
    }

    /* ===== FOOTER ACTION ===== */
    .action-footer {
        margin-top: 2rem;
    }

    .btn-continue {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #1a1a2e, #0f3460);
        color: #fff;
        text-decoration: none;
        border-radius: 10px;
        padding: 12px 28px;
        font-size: 15px;
        font-weight: 500;
        transition: opacity 0.2s;
    }

    .btn-continue:hover {
        opacity: 0.88;
        color: #fff;
        text-decoration: none;
    }

    /* RESPONSIVE: make order confirmation table fit smaller screens */
    .custom-table-container {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .custom-table {
        table-layout: fixed;
        width: 100%;
    }

    .custom-table th,
    .custom-table td {
        word-break: break-word;
        white-space: normal;
    }

    /* column width hints */
    .custom-table thead th:nth-child(1), .custom-table td:nth-child(1) { width: 110px; }
    .custom-table thead th:nth-child(2), .custom-table td:nth-child(2) { width: 220px; }
    .custom-table thead th:nth-child(3), .custom-table td:nth-child(3) { width: 80px; }
    .custom-table thead th:nth-child(4), .custom-table td:nth-child(4) { width: 120px; }

   @@media (max-width: 768px) {
    .custom-table-container { padding: 8px 6px; }
    .custom-table { min-width: 900px; }

    .custom-table-head th {
        padding: 10px 8px;
        font-size: 12px;
        white-space: nowrap;
    }

    .custom-table-row td {
        padding: 8px 8px;
        font-size: 13px;
        white-space: nowrap;
    }

    .custom-table thead th { position: sticky; top: 0; z-index: 8; }
    .custom-table thead th { background: linear-gradient(135deg, #1a1a2e, #0f3460); }

    .payment-badge, .status-badge { white-space: normal; display: inline-block; padding: 6px 8px; }
    .order-id-badge { display:inline-block; max-width:120px; overflow:hidden; text-overflow:ellipsis; }
    .product-name-cell { max-width: 220px; }

    .btn-cancel-order {
        padding: 6px 10px;
        font-size: 12px;
        white-space: nowrap;
    }
}

    @@media (max-width: 480px) {
        .custom-table { min-width: 760px; }
        .custom-table-head th { font-size: 11px; padding: 8px 6px; }
        .custom-table-row td { font-size: 12px; padding: 6px 6px; }
        .payment-badge, .status-badge { font-size: 11px; padding: 4px 6px; }
    }
</style>

@section Scripts {
    <script>
        $(document).on("click", ".btn-cancel-order", function () {
            if (!confirm("Bạn có chắc muốn hủy đơn hàng này không?")) return;

            var id = $(this).data("id");
            var $btn = $(this);

            $.post("@Url.Action("CancelOrder", "Cart")", { orderId: id })
                .done(function (response) {
                    if (response.success) {
                        var $row = $btn.closest("tr");
                        $row.find(".order-status").html('<span class="status-badge status-cancelled"><i class="ti ti-x"></i> Đã hủy</span>');
                        $btn.closest(".cancel-action").html('<span class="cancel-done"><i class="ti ti-circle-check"></i> Đã hủy</span>');
                    } else {
                        $("#message").html('<div class="alert alert-danger">' + response.message + '</div>');
                    }
                })
                .fail(function () {
                    $("#message").html('<div class="alert alert-danger">Không thể hủy đơn hàng. Vui lòng thử lại.</div>');
                });
        });
    </script>
}