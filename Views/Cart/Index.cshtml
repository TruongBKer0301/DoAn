@model IEnumerable<LapTopBD.Models.CartItem>

@* 
<!-- Page Header Start -->
<div class="container-fluid bg-secondary mb-5">
    <div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 300px">
        <h1 class="font-weight-semi-bold text-uppercase mb-3">Giỏ Hàng</h1>
        <div class="d-inline-flex">
            <p class="m-0"><a href="@Url.Action("Index", "Home")">Trang Chủ</a></p>
            <p class="m-0 px-2">-</p>
            <p class="m-0">Giỏ Hàng</p>
        </div>
    </div>
</div> *@
<!-- Cart Start -->
<div class="custom-container pt-5">
    <div class="row px-xl-5">
        <div class="col-lg-8 table-responsive mb-5">
            <form id="cartForm">
                <table class="custom-table text-center mb-0">
                    <thead class="custom-table-head">
                        <tr>
                            <th>
                                <input type="checkbox" id="selectAll" /> Chọn tất cả
                            </th>
                            <th>Sản phẩm</th>
                            <th>Giá</th>
                            <th>Số lượng</th>
                            <th>Tổng</th>
                            <th>Xóa</th>
                        </tr>
                    </thead>
                    <tbody class="align-middle">
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var total = item.Quantity * item.Product ?.ProductPrice;
                                <tr class="custom-table-row">
                                    <td class="align-middle">
                                        <input type="checkbox" class="item-checkbox" value="@item.ProductId" checked />
                                    </td>
                                    <td class="align-middle">
                                        <img src="@item.Product?.ProductImage1" alt="" class="img-fluid me-2" style="width: 48px; max-width: 48px; height: auto;"> @item.Product?.ProductName
                                    </td>
                                    <td class="align-middle custom-price">@item.Product?.ProductPrice.ToString("#,##0 VNĐ")</td>
                                    <td class="align-middle">
                                        <div class="custom-quantity-group mx-auto" data-price="@item.Product.ProductPrice" data-shipping-charge="@item.Product.ShippingCharge">
                                            <div class="input-group-btn">
                                                <button type="button" class="custom-quantity-btn btn-minus" data-id="@item.Id">
                                                    <i class="fa fa-minus"></i>
                                                </button>
                                            </div>
                                            <input type="text" class="custom-quantity-input" value="@item.Quantity">
                                            <div class="input-group-btn">
                                                <button type="button" class="custom-quantity-btn btn-plus" data-id="@item.Id">
                                                    <i class="fa fa-plus"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <span class="custom-total">@((item.Product.ProductPrice * item.Quantity).ToString("#,##0 VNĐ"))</span>
                                    </td>
                                    <td class="align-middle">
                                        <button type="button" class="custom-btn btn-remove" data-id="@item.Id">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">Giỏ hàng của bạn đang trống!</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </form>
        </div>

        <!-- Phần Tóm Tắt Giỏ Hàng -->
        <div class="col-lg-4">
            <form class="mb-5" action="">
                <div class="input-group">
                    <input type="text" class="custom-input p-4" placeholder="Mã giảm giá">
                    <div class="input-group-append">
                        <button type="button" class="custom-btn mt-2">Áp dụng</button>
                    </div>
                </div>
            </form>
            <div class="custom-card mb-5">
                <div class="custom-card-header">
                    <h4 class="font-weight-semi-bold m-0 text-white">Tóm tắt giỏ hàng</h4>
                </div>
                <div class="custom-card-body">
                    <div class="d-flex justify-content-between mb-3 pt-1">
                        <h6 class="font-weight-medium">Tạm tính</h6>
                        <h6 id="subtotal" class="custom-price">@Model.Sum(item => item.Quantity * item.Product.ProductPrice).ToString("#,##0 VNĐ")</h6>
                    </div>
                    <div class="d-flex justify-content-between">
                        <h6 class="font-weight-medium">Phí vận chuyển</h6>
                        <h6 id="shipping" class="custom-price">@Model.Sum(item => item.Product.ShippingCharge).ToString("#,##0 VNĐ")</h6>
                    </div>
                </div>
                <div class="custom-card-footer">
                    <div class="d-flex justify-content-between mt-2">
                        <h5 class="font-weight-bold p-2">Tổng cộng</h5>
                        <h5 id="grand-total" class="custom-total">@((Model.Sum(item => item.Quantity * item.Product.ProductPrice) + Model.Sum(item => item.Product.ShippingCharge)).ToString("#,##0 VNĐ"))</h5>
                    </div>
                    <button type="button" class="custom-btn custom-btn-block my-3" onclick="checkoutSelected()">Tiến hành thanh toán</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Cart End -->


@section Scripts {
<script>
// 🔥 CHECKOUT
function checkoutSelected() {
    const selectedIds = $('.item-checkbox:checked').map(function () {
        return this.value;
    }).get();

    if (selectedIds.length === 0) {
        alert('Vui lòng chọn sản phẩm!');
        return;
    }

    const params = new URLSearchParams();
    selectedIds.forEach(id => params.append('selectedProductIds', id));

    window.location.href = '/Cart/Checkout?' + params.toString();
}
</script>
}
<style>
/* =========================
   GLOBAL CART THEME
========================= */
.custom-container {
    background: #f5f7fb;
    min-height: 100vh;
}

/* =========================
   TABLE WRAPPER
========================= */
.custom-table {
    width: 100%;
    background: #ffffff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    border: 1px solid #eef2f7;
}

/* HEADER */
.custom-table-head {
    background: linear-gradient(135deg, #1a1a2e, #0f3460);
    color: #fff;
}

.custom-table-head th {
    padding: 14px;
    font-weight: 600;
    font-size: 14px;
    border: none;
}

/* ROW */
.custom-table-row {
    transition: 0.2s ease;
    background: #fff;
}

.custom-table-row:hover {
    background: #f8fafc;
}

/* PRODUCT IMAGE */
.custom-table-row img {
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

/* PRICE */
.custom-price {
    font-weight: 700;
    color: #0f3460;
}

/* TOTAL */
.custom-total {
    font-weight: 800;
    color: #dc2626;
}

/* =========================
   QUANTITY CONTROL
========================= */
.custom-quantity-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.custom-quantity-input {
    width: 28px;
    text-align: center;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    font-weight: 600;
}

.custom-quantity-btn {
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 8px;
    background: #0f3460;
    color: #fff;
    font-size: 14px;
    transition: 0.2s;
}

.custom-quantity-btn:hover {
    background: #16213e;
}


/* =========================
   CHECKBOX
========================= */
.item-checkbox,
#selectAll {
    width: 20px;
    height: 20px;
    accent-color: #0f3460;
}

/* =========================
   REMOVE BUTTON
========================= */
.btn-remove {
    border: none;
    background: transparent;
    color: #ef4444;
    font-size: 18px;
    transition: 0.2s;
}

.btn-remove:hover {
    color: #dc2626;
    transform: scale(1.1);
}

/* =========================
   COUPON INPUT
========================= */
.custom-input {
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    padding: 10px;
    width: 100%;
}

.custom-input:focus {
    outline: none;
    border-color: #0f3460;
    box-shadow: 0 0 0 3px rgba(15,52,96,0.1);
}

/* =========================
   BUTTONS
========================= */
.custom-btn {
    background: linear-gradient(135deg, #1a1a2e, #0f3460);
    color: #fff;
    border: none;
    padding: 10px 16px;
    border-radius: 10px;
    font-weight: 600;
    transition: 0.2s;
}

.custom-btn:hover {
    opacity: 0.9;
}

.custom-btn-block {
    width: 100%;
}

/* =========================
   SUMMARY CARD
========================= */
.custom-card {
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    overflow: hidden;
    border: 1px solid #eef2f7;
}

.custom-card-header {
    background: linear-gradient(135deg, #1a1a2e, #0f3460);
    padding: 12px;
}

.custom-card-body {
    padding: 16px;
}

.custom-card-footer {
    padding: 16px;
    border-top: 1px solid #f1f5f9;
}

/* TEXT */
.custom-card h4,
.custom-card h5 {
    color: #fff;
}

/* SUMMARY TEXT */
.custom-card-body h6 {
    color: #0f172a;
}

/* =========================
   RESPONSIVE
========================= */
@@media (max-width: 768px) {

    .custom-table-head th {
        font-size: 12px;
        padding: 10px;
    }

    .custom-quantity-group {
        flex-direction: row;
    }

    .custom-card {
        margin-top: 20px;
    }
}</style>