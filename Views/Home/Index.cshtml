@{
    ViewData["Title"] = "Home Page";
}

<!-- Product New -->
<div class="container-fluid">
    <div class="text-center">
        <h2 class="section-title px-5"><span class="px-2">Sản phẩm mới</span></h2>
    </div>
    <div class="owl-carousel product-carousel owl-theme product-new">
        @if (ViewBag.NewProduct != null && ViewBag.NewProduct.Count > 0)
        {
            @foreach (var product in (ViewBag.NewProduct as List<LapTopBD.ViewModels.ProductViewModel>) ?? new
                                List<LapTopBD.ViewModels.ProductViewModel>())
            {
                // Sửa lại logic kiểm tra hasDiscount
                var hasDiscount = product.ProductPriceBeforeDiscount.HasValue && product.ProductPriceBeforeDiscount.Value >
        product.ProductPrice;
                var discountPercentage = hasDiscount ? (1 - product.ProductPrice /
        product.ProductPriceBeforeDiscount.GetValueOrDefault()) * 100 : 0;

                <div class="item" data-aos="fade-up" data-aos-duration="2500">
                    <div class="card shadow h-100">
                        <div class="ratio ratio-1x1">
                            <a href="@Url.Action("Detail", "Home", new { slug = product.Slug })">
                                <img class="img-fluid w-100" src="@product.ProductImage1" alt="@product.ProductName" />
                            </a>
                            <button class="btn-add-to-fav" id="add-to-fav-btn" data-product-id="@product.Id"
                                    title="Thêm vào yêu thích">
                                <i class="ri-heart-line"></i>
                            </button>

                            @if (product.quantity < 1)
                            {
                                <span class="discount-tag out-of-stock">Hết hàng</span>
                            }
                            else if (hasDiscount)
                            {
                                <span class="discount-tag">Giảm @((int)discountPercentage)%</span>
                            }
                        </div>
                        <div class="card-body">
                            <div>
                                <a href="@Url.Action("Detail", "Home", new { slug = product.Slug })">
                                    <p class="card-text">@product.ProductName</p>
                                </a>
                            </div>
                            <div class="d-flex mb-3">
                                @{
                                    double averageRating = product?.AverageRating ?? 0;
                                    int fullStars = (int)averageRating;
                                    bool hasHalfStar = (averageRating - fullStars) >= 0.5;
                                    int emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                                }

                                <div class="review-star mr-2">
                                    @for (int i = 0; i < fullStars; i++)
                                    {
                                        <small class="fas fa-star"></small> <!-- Sao đầy -->
                                    }
                                    @if (hasHalfStar)
                                    {
                                        <small class="fas fa-star-half-alt"></small> <!-- Sao nửa -->
                                    }
                                    @for (int i = 0; i < emptyStars; i++)
                                    {
                                        <small class="far fa-star"></small> <!-- Sao rỗng -->
                                    }
                                </div>

                            </div>
                            <div class="price-wrapper">
                                @if (hasDiscount)
                                {
                                    <div class="original-price">@(product.ProductPriceBeforeDiscount?.ToString("N0") ?? "") VND
                                    </div>
                                    <div class="discount-price">@product.ProductPrice.ToString("N0") VND</div>
                                }
                                else
                                {
                                    <div class="original-price">@product.ProductPrice.ToString("N0") VND</div>
                                }
                            </div>
                            @if (product.quantity < 1)
                            {
                                <button class="btn-add-to-cart bg-danger" id="add-to-cart-btn">
                                    <i class=" ri-phone-fill"></i> Tạm thời hết hàng
                                </button>
                            }
                            else
                            {
                                <div class="product-action-row flex-wrap gap-2">
                                    <button class="btn-add-to-cart" id="add-to-cart-btn" data-product-id="@product.Id">
                                        <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
                                    </button>
                                    <button class="btn-buy-now" data-product-id="@product.Id">
                                        <i class="fas fa-bolt"></i> Mua ngay
                                    </button>
                                </div>
                            }
                            
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p>Không có sản phẩm mới nào để hiển thị.</p>
        }
    </div>
</div>
<!-- Product New End -->
