                                        }

                                        .cbar-slot--empty {
                                            border-style: dashed;
                                            border-color: #cbd5e1;
                                            flex-direction: column;
                                            justify-content: center;
                                            text-align: center;
                                        }

                                        .cbar-slot--empty:hover {
                                            border-color: #2563eb;
                                            box-shadow: 0 0 0 3px rgba(37, 99, 235, .1);
                                        }

                                        .cbar-slot--filled {
                                            border-color: #16a34a;
                                            background: #f0fdf4;
                                        }

                                        .cbar-img-wrap img {
                                            width: 48px;
                                            height: 48px;
                                            object-fit: cover;
                                            border-radius: 8px;
                                            flex-shrink: 0;
                                        }

                                        .cbar-name {
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: #1f2937;
                                            display: -webkit-box;
                                            -webkit-line-clamp: 2;
                                            -webkit-box-orient: vertical;
                                            overflow: hidden;
                                        }

                                        .cbar-plus {
                                            font-size: 22px;
                                            color: #94a3b8;
                                            line-height: 1;
                                        }

                                        .cbar-hint {
                                            font-size: 12px;
                                            color: #94a3b8;
                                            margin-top: 4px;
                                        }

                                        /* Nút X xóa slot */
                                        .cbar-remove-btn {
                                            position: absolute;
                                            top: 4px;
                                            right: 6px;
                                            background: none;
                                            border: none;
                                            color: #94a3b8;
                                            font-size: 14px;
                                            cursor: pointer;
                                            line-height: 1;
                                            padding: 2px 4px;
                                            border-radius: 50%;
                                            transition: color .2s, background .2s;
                                        }

                                        .cbar-remove-btn:hover {
                                            color: #ef4444;
                                            background: #fee2e2;
                                        }

                                        /* Actions */
                                        .cbar-actions {
                                            display: flex;
                                            flex-direction: column;
                                            align-items: flex-end;
                                            gap: 6px;
                                            margin-left: auto;
                                            flex-shrink: 0;
                                        }

                                        .cbar-count {
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: #374151;
                                            white-space: nowrap;
                                        }

                                        .cbar-actions .btn {
                                            min-width: 90px;
                                        }

                                        /* ======== MODAL PICK GRID ======== */
                                        .pick-grid {
                                            display: grid;
                                            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
                                            gap: 14px;
                                            max-height: 55vh;
                                            overflow-y: auto;
                                        }

                                        .pick-card {
                                            border: 2px solid #e2e8f0;
                                            border-radius: 14px;
                                            padding: 12px;
                                            cursor: pointer;
                                            transition: all .2s;
                                            background: #fff;
                                        }

                                        .pick-card:hover {
                                            border-color: #93c5fd;
                                            transform: translateY(-2px);
                                            box-shadow: 0 8px 20px rgba(37, 99, 235, .1);
                                        }

                                        .pick-card.selected {
                                            border-color: #2563eb;
                                            background: #eff6ff;
                                        }

                                        .pick-card.selected::after {
                                            content: '✓';
