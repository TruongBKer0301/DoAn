                                            transform: scale(1.1);
                                        }

                                        .btn-add-to-fav i {
                                            font-size: 1.2rem;
                                        }

                                        /* ======== THANH SO SÁNH NỔI ======== */
                                        .compare-bar {
                                            position: fixed;
                                            bottom: 0;
                                            width: 70%;
                                            left: 50%;
                                            transform: translateX(-50%);
                                            background: #fff;
                                            border-top: 2px solid #e2e8f0;
                                            box-shadow: 0 -4px 24px rgba(0, 0, 0, .12);
                                            z-index: 1050;
                                            padding: 12px 24px;
                                            transition: transform .3s ease;
                                            border-radius: 15px 15px 0 0;
                                        }

                                        .compare-bar.collapsed {
                                            transform: translateY(calc(100% - 44px));
                                        }

                                        .compare-bar-inner {
                                            display: flex;
                                            align-items: center;
                                            gap: 16px;
                                            max-width: ;
                                            margin: 0 auto;
                                        }

                                        /* Slot chung */
                                        .cbar-slot {
                                            position: relative;
                                            display: flex;
                                            align-items: center;
                                            gap: 10px;
                                            border: 1px solid #e2e8f0;
                                            border-radius: 12px;
                                            padding: 8px 12px;
                                            min-width: 200px;
                                            max-width: 260px;
                                            flex: 1;
                                            background: #f8fafc;
                                            cursor: pointer;
                                            transition: border-color .2s, box-shadow .2s;
