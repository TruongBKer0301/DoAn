                                            font-size: 15px;
                                        }

                                        .pick-card {
                                            position: relative;
                                        }

                                        .pick-card.disabled {
                                            opacity: .4;
                                            pointer-events: none;
                                        }

                                        .pick-card__img {
                                            aspect-ratio: 1/1;
                                            border-radius: 10px;
                                            overflow: hidden;
                                            border: 1px solid #e2e8f0;
                                            margin-bottom: 8px;
                                        }

                                        .pick-card__img img {
                                            width: 100%;
                                            height: 100%;
                                            object-fit: contain;
                                        }

                                        .pick-card__name {
                                            font-size: 13px;
                                            font-weight: 600;
                                            line-height: 1.4;
                                            color: #1f2937;
                                        }

                                        .pick-card__brand {
                                            font-size: 12px;
                                            color: #64748b;
                                            margin-top: 3px;
                                        }

                                        .modal-close-btn {
                                            appearance: none;
                                            border: 0;
                                            background: transparent;
                                            color: #6b7280;
                                            font-size: 2rem;
                                            line-height: 1;
                                            padding: 0;
                                            margin-left: auto;
                                            cursor: pointer;
                                        }

                                        .modal-close-btn:hover {
                                            color: #111827;
                                        }

                                        .modal-header {
                                            align-items: center;
                                        }

                                        .pick-product-modal-dialog {
                                            max-width: 760px;
                                            margin-top: -10px;
                                        }

                                        #pickProductModal .modal-body {
                                            max-height: 62vh;
                                            overflow-y: auto;

                                        }

                                        /* ======== BẢNG SO SÁNH ======== */
                                        .compare-table {
                                            table-layout: fixed;
                                            width: 100%;
                                        }

                                        #cmpHead th,
                                        #cmpBody th,
                                        #cmpBody td {
                                            vertical-align: middle;
                                        }

                                        #cmpHead th {
                                            background: #f1f5f9;
                                            font-weight: 700;
                                            text-align: center;
                                        }

                                        #cmpBody td,
                                        #cmpHead th {
                                            white-space: normal;
                                            word-break: break-word;
                                            overflow-wrap: anywhere;
                                        }

                                        .cmp-current-col {
                                            color: #dc3545;
                                            font-weight: 700;
                                            text-align: left !important;
                                            padding-left: 12px !important;
                                        }

                                        .cmp-description {
                                            max-height: 160px;
                                            overflow-y: auto;
                                            white-space: normal;
                                            line-height: 1.55;
                                            font-size: 13px;
                                            font-family: inherit;
                                        }

                                        .cmp-img {
                                            width: 150px;
                                            object-fit: contain;
                                            display: block;
                                            margin: 6px auto;
                                        }

                                        @@media (max-width: 768px) {
                                            .compare-bar-inner {
                                                flex-wrap: wrap;
                                            }

                                            .cbar-slot {
                                                min-width: 140px;
                                            }
                                        }
                                    </style>

                                    <!-- ============================================================
     SCRIPTS
     ============================================================ -->
                                    <script>
                                        /* ---------- Quantity ---------- */
                                        (function () {
                                            const input = document.getElementById('quantity');
                                            const btnP = document.getElementById('btn-plus');
                                            const btnM = document.getElementById('btn-minus');
                                            const msg = document.getElementById('qty-message');
                                            const max = parseInt(input.max) || 1;
                                            const min = parseInt(input.min) || 1;
                                            upd();

                                            function increaseQty(e) {
                                                e.preventDefault(); e.stopImmediatePropagation();
                                                let v = parseInt(input.value) || 1;
                                                if (v >= max) { input.value = max; show(`Không được vượt quá tồn kho (${max})`); }
                                                else { input.value = v + 1; clear(); }
                                                upd();
                                            }
                                            function decreaseQty(e) {
                                                e.preventDefault(); e.stopImmediatePropagation();
                                                let v = parseInt(input.value) || 1;
                                                if (v <= min) { input.value = min; show(`Số lượng tối thiểu là ${min}`); }
                                                else { input.value = v - 1; clear(); }
                                                upd();
                                            }
                                            input.addEventListener('input', () => {
                                                let v = parseInt(input.value) || 1;
                                                if (v < min) { input.value = min; show(`Số lượng tối thiểu là ${min}`); }
                                                else if (v > max) { input.value = max; show(`Không được vượt quá tồn kho (${max})`); }
                                                else { clear(); }
                                                upd();
                                            });
                                            function show(t) { msg.textContent = t; }
                                            function clear() { msg.textContent = ''; }
                                            function upd() { let v = parseInt(input.value) || 1; btnP.disabled = v >= max; btnM.disabled = v <= min; }
                                            window.increaseQty = increaseQty;
                                            window.decreaseQty = decreaseQty;
                                        })();

                                        /* ---------- Compare ---------- */
                                        document.addEventListener('DOMContentLoaded', function () {
                                            /* Dữ liệu sản phẩm hiện tại */
                                            const CURRENT = {
                                                id: '@(Model?.Id)',
                                                name: '@(Model?.ProductName?.Replace("'","\\'")??"Sản phẩm hiện tại")',
                                                image: '@(Model?.ProductImage1??"")',
                                                price: '@(Model?.ProductPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)??"0")',
                                                description: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.ProductDescription ?? "")),
                                                brand: '@(Model?.Brand??"")',
                                                cpu: '@(Model?.CPU??"")',
                                                ram: '@(Model?.RAM??"")',
                                                storage: '@(Model?.Storage??"")',
                                                gpu: '@(Model?.GPU??"")',
                                                vga: '@(Model?.VGA??"")',
                                                pin: '@(Model?.PIN??"")',
                                                weight: '@(Model?.WEIGHT??"")',
                                                size: '@(Model?.SIZE??"")',
                                                bonus: '@(Model?.BONUS??"")',
                                                rating: '@(Model?.AverageRating.ToString("0.0",System.Globalization.CultureInfo.InvariantCulture)??"0")',
                                                quantity: '@(Model?.quantity??0)'
                                            };

                                            const FIELDS = [
                                                { k: 'price', l: 'Giá bán' },
                                                { k: 'description', l: 'Mô tả sản phẩm' },
                                                { k: 'brand', l: 'Thương hiệu' },
                                                { k: 'cpu', l: 'CPU' },
                                                { k: 'ram', l: 'RAM' },
                                                { k: 'storage', l: 'Bộ nhớ' },
                                                { k: 'gpu', l: 'GPU' },
                                                { k: 'vga', l: 'VGA' },
                                                { k: 'pin', l: 'Pin' },
                                                { k: 'weight', l: 'Khối lượng' },
                                                { k: 'size', l: 'Kích thước' },
                                                { k: 'rating', l: 'Đánh giá' },
                                                { k: 'quantity', l: 'Tồn kho' },
                                                { k: 'bonus', l: 'Thông tin bổ sung' }
                                            ];

                                            /* State */
                                            let slots = [null, null];   // dữ liệu 2 slot
                                            let activeSlot = 0;              // slot đang chờ chọn

                                            /* Elements */
                                            const compareBar = document.getElementById('compareBar');
                                            const btnOpenBar = document.getElementById('btnOpenCompareBar');
                                            const btnCloseBar = document.getElementById('btnCloseCompareBar');
                                            const btnDoCompare = document.getElementById('btnDoCompare');
                                            const btnReCompare = document.getElementById('btnReCompare');
                                            const cbarCount = document.getElementById('cbarCount');
                                            const cbarSlotEls = [document.getElementById('cbarSlot0'), document.getElementById('cbarSlot1')];

                                            const pickModal = new bootstrap.Modal(document.getElementById('pickProductModal'));
                                            const resultModal = new bootstrap.Modal(document.getElementById('compareResultModal'));
                                            const pickGrid = document.getElementById('pickGrid');
                                            const pickSearch = document.getElementById('pickSearchInput');

                                            /* 1. Bấm nút "So sánh" → hiện thanh nổi */
                                            btnOpenBar?.addEventListener('click', () => {
                                                compareBar.classList.remove('d-none', 'collapsed');
                                                compareBar.scrollIntoView({ behavior: 'smooth', block: 'end' });
                                            });

                                            /* 2. Đóng thanh so sánh */
                                            btnCloseBar?.addEventListener('click', () => {
                                                compareBar.classList.add('d-none');
                                            });

                                            /* 3. Bấm slot trống → mở modal chọn sản phẩm */
                                            cbarSlotEls.forEach((el, i) => {
                                                el.addEventListener('click', function (e) {
                                                    if (e.target.classList.contains('cbar-remove-btn')) return;
                                                    activeSlot = i;
                                                    openPickModal();
                                                });
                                            });

                                            /* 4. Nút X xóa slot */
                                            document.querySelectorAll('.cbar-remove-btn[data-slot]').forEach(btn => {
                                                btn.addEventListener('click', e => {
                                                    e.stopPropagation();
                                                    const i = parseInt(btn.dataset.slot);
                                                    clearSlot(i);
                                                });
                                            });

                                            /* 5. Tìm kiếm trong modal */
                                            pickSearch?.addEventListener('input', function () {
                                                const q = this.value.trim().toLowerCase();
                                                pickGrid.querySelectorAll('.pick-card').forEach(c => {
                                                    c.style.display = (!q || c.dataset.nameLower.includes(q)) ? '' : 'none';
                                                });
                                            });

                                            /* 6. Click chọn card trong modal */
                                            pickGrid?.addEventListener('click', function (e) {
                                                const card = e.target.closest('.pick-card');
                                                if (!card || card.classList.contains('disabled')) return;
                                                pickGrid.querySelectorAll('.pick-card').forEach(c => c.classList.remove('selected'));
                                                card.classList.add('selected');
                                                // Tự động chọn ngay khi click (không cần nút Chọn riêng)
                                                confirmPick(card);
                                            });

                                            /* 7. Nút So sánh → hiện bảng kết quả */
                                            btnDoCompare?.addEventListener('click', () => {
                                                const filled = slots.filter(s => s);
                                                if (filled.length === 0) {
                                                    alert('Vui lòng chọn ít nhất 1 sản phẩm để so sánh.');
                                                    return;
                                                }
                                                buildResultTable();
                                                resultModal.show();
                                            });

                                            /* 8. So sánh lại */
                                            btnReCompare?.addEventListener('click', () => {
                                                resultModal.hide();
                                            });

                                            /* ---- Helpers ---- */
                                            function openPickModal() {
                                                // reset search & selection
                                                pickSearch.value = '';
                                                const otherId = slots[1 - activeSlot]?.id;
                                                pickGrid.querySelectorAll('.pick-card').forEach(c => {
                                                    c.classList.remove('selected');
                                                    c.style.display = '';
                                                    // disable card đang ở slot kia hoặc là sản phẩm hiện tại
                                                    c.classList.toggle('disabled', c.dataset.id === CURRENT.id || c.dataset.id === otherId);
                                                });
                                                pickModal.show();
                                            }

                                            function confirmPick(card) {
                                                slots[activeSlot] = {
                                                    id: card.dataset.id,
                                                    name: card.dataset.name,
                                                    image: card.dataset.image,
                                                    price: card.dataset.price,
                                                    description: card.dataset.description,
                                                    brand: card.dataset.brand,
                                                    cpu: card.dataset.cpu,
                                                    ram: card.dataset.ram,
                                                    storage: card.dataset.storage,
                                                    gpu: card.dataset.gpu,
                                                    vga: card.dataset.vga,
                                                    pin: card.dataset.pin,
                                                    weight: card.dataset.weight,
                                                    size: card.dataset.size,
                                                    bonus: card.dataset.bonus,
                                                    rating: card.dataset.rating,
                                                    quantity: card.dataset.quantity
                                                };
                                                pickModal.hide();
                                                renderSlot(activeSlot);
                                                updateCount();
                                            }

                                            function renderSlot(i) {
                                                const el = cbarSlotEls[i];
                                                const p = slots[i];
                                                const removeBtn = el.querySelector('.cbar-remove-btn');

                                                if (p) {
                                                    el.classList.remove('cbar-slot--empty');
                                                    el.classList.add('cbar-slot--filled');
                                                    el.innerHTML = `
                                                                                                                                                                    <button class="cbar-remove-btn" data-slot="${i}" title="Xóa">✕</button>
                                                                                                                                                                    <div class="cbar-img-wrap">
                                                                                                                                                                        <img src="${p.image}" alt="${p.name}" onerror="this.src='/images/laptop.png'" />
                                                                                                                                                                    </div>
                                                                                                                                                                    <div class="cbar-name">${p.name}</div>`;
                                                    // Re-bind remove
                                                    el.querySelector('.cbar-remove-btn').addEventListener('click', e => {
                                                        e.stopPropagation(); clearSlot(i);
                                                    });
                                                    // Re-bind click to re-pick
                                                    el.onclick = function (e) {
                                                        if (e.target.classList.contains('cbar-remove-btn')) return;
                                                        activeSlot = i; openPickModal();
                                                    };
                                                } else {
                                                    el.classList.add('cbar-slot--empty');
                                                    el.classList.remove('cbar-slot--filled');
                                                    el.innerHTML = `
                                                                                                                                                                    <button class="cbar-remove-btn d-none" data-slot="${i}" title="Xóa">✕</button>
                                                                                                                                                                    <div class="cbar-plus"><i class="fas fa-plus"></i></div>
                                                                                                                                                                    <div class="cbar-hint">Chọn sản phẩm so sánh</div>`;
                                                    el.onclick = function () { activeSlot = i; openPickModal(); };
                                                }
                                            }

                                            function clearSlot(i) {
                                                slots[i] = null;
                                                renderSlot(i);
                                                updateCount();
                                            }

                                            function updateCount() {
                                                const n = slots.filter(s => s).length;
                                                cbarCount.textContent = `Đã chọn ${n} sản phẩm`;
                                            }

                                            function fmt(val) {
                                                const n = Number(val);
                                                return isNaN(n) ? 'Chưa có' : new Intl.NumberFormat('vi-VN').format(n) + ' VND';
                                            }

                                            function escapeHtml(val) {
                                                return String(val ?? '')
                                                    .replace(/&/g, '&amp;')
                                                    .replace(/</g, '&lt;')
                                                    .replace(/>/g, '&gt;')
                                                    .replace(/"/g, '&quot;')
                                                    .replace(/'/g, '&#39;');
                                            }

                                            function buildResultTable() {
                                                const products = [CURRENT, ...slots.filter(s => s)];
                                                const head = document.getElementById('cmpHead');
                                                const body = document.getElementById('cmpBody');
                                                const attributeWidth = '160px';
                                                const productWidth = `calc((100% - ${attributeWidth}) / ${products.length})`;

                                                head.innerHTML = `<th style="width:${attributeWidth};min-width:${attributeWidth}">Thuộc tính</th>` +
                                                    products.map((p, i) => {
                                                        const name = p.name || '';
                                                        const currentClass = i === 0 ? ' cmp-current-col' : '';
                                                        return `<th class="${currentClass}" style="width:${productWidth}">${name}</th>`;
                                                    }).join('');

                                                // first row: images
                                                const imageRow = `<tr><th style="width:${attributeWidth};min-width:${attributeWidth}">Hình ảnh</th>` +
                                                    products.map(p => `<td style="width:${productWidth}"><img src="${p.image || '/images/laptop.png'}" alt="${(p.name || '').replace(/"/g, '&quot;')}" class="cmp-img"/></td>`).join('') + `</tr>`;

                                                body.innerHTML = imageRow + FIELDS.map(f => {
                                                    const cells = products.map(p => {
                                                        let v = (p[f.k] || '').toString().trim();
                                                        if (!v) return `<td class="${p === CURRENT ? 'cmp-current-col' : ''}"><span class="text-muted">Chưa có</span></td>`;
                                                        if (f.k === 'price') v = `<strong>${fmt(v)}</strong>`;
                                                        else if (f.k === 'description') v = `<div class="cmp-description">${v}</div>`;
                                                        if (f.k === 'rating') v = `${v} / 5 ⭐`;
                                                        if (f.k === 'quantity') v = `${v} sản phẩm`;
                                                        return `<td class="${p === CURRENT ? 'cmp-current-col' : ''}" style="width:${productWidth}">${v}</td>`;
                                                    }).join('');
                                                    return `<tr><th style="width:${attributeWidth};min-width:${attributeWidth}">${f.l}</th>${cells}</tr>`;
                                                }).join('');
                                            }
                                        });
                                    </script>
                                    <script>
                                        document.addEventListener("DOMContentLoaded", function () {
                                            const product = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
                                                {
                                                    id = Model?.Id,
                                                    name = Model?.ProductName,
                                                    image = Model?.ProductImage1,
                                                    price = Model?.ProductPrice,
                                                    priceBeforeDiscount = Model?.ProductPriceBeforeDiscount,
                                                    slug = Model?.Slug,
                                                    quantity = Model?.quantity,
                                                    averageRating = Model?.AverageRating
                                                }));

                                            if (!product || !product.id) return;

                                            let viewedProducts = [];

                                            try {
                                                viewedProducts = JSON.parse(localStorage.getItem("viewedProducts")) || [];
                                            } catch {
                                                viewedProducts = [];
                                            }

                                            viewedProducts = viewedProducts.filter(x => String(x.id) !== String(product.id));
                                            viewedProducts.unshift(product);
                                            viewedProducts = viewedProducts.slice(0, 5);

                                            localStorage.setItem("viewedProducts", JSON.stringify(viewedProducts));
                                        });
                                    </script>
