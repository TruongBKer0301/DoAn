@model List<LapTopBD.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Sản phẩm";
}

<!-- Page Header Start -->
<div class="container-fluid hero-cart mb-5">
    <div class="hero-inner">
        <div class="hero-badge">
            <i class="ti ti-heart"></i>
            <span>Toàn bộ</span>
        </div>
        <h1 class="hero-title">Sản phẩm ưa thích</h1>
        <div class="hero-divider"></div>
        <div class="hero-breadcrumb">
            <a href="@Url.Action("Index", "Home")">Trang Chủ >></a>
            <i class="ti ti-chevron-right"></i>
            <span class="hero-bc-cur">Sản phẩm ưa thích</span>
        </div>
    </div>
</div>
<!-- Page Header End -->
<!-- Shop Start -->
<div class="container-fluid pt-5">
    <div class="row px-xl-5">
        <!-- Shop Product Start -->
        <div class="col-lg-12 col-md-12">
            <div class="row pb-3">
                <div class="col-12">
                    <div class="row" id="productContainer">
                        @if (Model?.Any() == true)
                        {
                            foreach (var product in Model)
                            {
                                var hasDiscount = product.ProductPriceBeforeDiscount.HasValue && product.ProductPriceBeforeDiscount > product.ProductPrice;
                                var discountPercentage = hasDiscount ? (product.ProductPriceBeforeDiscount!.Value - product.ProductPrice) / product.ProductPriceBeforeDiscount!.Value * 100 : 0;
                                <div class="col-lg-3 col-md-6 col-sm-12 pb-5">
                                    <div class="item" data-aos="fade-up" data-aos-duration="2500">
                                        <div class="card shadow h-100">
                                            <div class="ratio ratio-1x1">
                                                <a href="@Url.Action("Detail", "Home", new { slug = product.Slug })">
                                                    <img class="img-fluid w-100 h-100 object-fit-cover" src="@product.ProductImage1" alt="@(product.ProductName ?? "Product")" />
                                                </a>

                                                <button class="remove-fav-btn btn-add-to-fav is-favorited" data-id="@product.Id" title="Xóa khỏi yêu thích">
                                                    <i class="ri-heart-fill"></i>
                                                </button>

                                                @if (product.quantity < 1)
                                                {
                                                    <span class="discount-tag out-of-stock">Hết hàng</span>
                                                }
                                                else if (hasDiscount)
                                                {
                                                    <span class="discount-tag">Giảm @((int)discountPercentage)%</span>
                                                }
                                            </div>
                                            <div class="card-body text-center">
                                                <div>
                                                    <a href="@Url.Action("Detail", "Home", new { slug = product.Slug })">
                                                        <p class="card-text">@(product.ProductName ?? "Unnamed Product")</p>
                                                    </a>
                                                </div>

                                                <div class="d-flex mb-3">
                                                    @{
                                                        double averageRating = product?.AverageRating ?? 0;
                                                        int fullStars = (int)averageRating;
                                                        bool hasHalfStar = (averageRating - fullStars) >= 0.5;
                                                        int emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
                                                    }

                                                    <div class="review-star mr-2">
                                                        @for (int i = 0; i < fullStars; i++)
                                                        {
                                                            <small class="fas fa-star"></small>
                                                        }
                                                        @if (hasHalfStar)
                                                        {
                                                            <small class="fas fa-star-half-alt"></small>
                                                        }
                                                        @for (int i = 0; i < emptyStars; i++)
                                                        {
                                                            <small class="far fa-star"></small>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="price-wrapper">
                                                    @if (hasDiscount)
                                                    {
                                                        <div class="original-price text-muted"><del>@product.ProductPriceBeforeDiscount!.Value.ToString("N0") VND</del></div>
                                                        <div class="discount-price text-danger font-weight-bold">@product.ProductPrice.ToString("N0") VND</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="original-price text-dark font-weight-bold">@product.ProductPrice.ToString("N0") VND</div>
                                                    }
                                                </div>

                                                @if (product.quantity < 1)
                                                {
                                                    <button class="btn-add-to-cart bg-danger">
                                                        <i class="ri-phone-fill"></i> Tạm thời hết hàng
                                                    </button>
                                                }
                                                else
                                                {
                                                    <div class="product-action-row">
                                                        <button class="btn-add-to-cart" data-product-id="@product.Id">
                                                            <i class="fas fa-shopping-cart"></i> Thêm vào giỏ hàng
                                                        </button>
                                                        <button class="btn-buy-now" data-product-id="@product.Id">
                                                            <i class="fas fa-bolt"></i> Mua ngay
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="col-12 text-center">Không có sản phẩm nào để hiển thị.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== HERO ===== */
    .hero-cart {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    }

    .hero-cart::before,
    .hero-cart::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
        pointer-events: none;
    }

    .hero-cart::before { width: 300px; height: 300px; top: -80px; left: -60px; }
    .hero-cart::after  { width: 380px; height: 380px; bottom: -110px; right: -50px; }

    .hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 240px;
        padding: 2.5rem 1rem;
        text-align: center;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255,255,255,0.08);
        border: 0.5px solid rgba(255,255,255,0.18);
        border-radius: 999px;
        padding: 5px 16px;
        margin-bottom: 1rem;
        color: rgba(255,255,255,0.75);
        font-size: 13px;
    }

    .hero-badge i { color: #a8c8ff; font-size: 15px; }

    .hero-title {
        font-size: 2rem;
        font-weight: 600;
        color: #fff;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: -0.01em;
    }

    .hero-divider {
        width: 44px;
        height: 2px;
        background: rgba(255,255,255,0.22);
        margin: .9rem auto;
    }

    .hero-breadcrumb {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
    }

    .hero-breadcrumb a { color: rgba(255,255,255,0.5); text-decoration: none; }
    .hero-breadcrumb a:hover { color: rgba(255,255,255,0.85); }
    .hero-breadcrumb i { font-size: 11px; color: rgba(255,255,255,0.28); }
    .hero-bc-cur { color: #f0a0a0; }
    .ratio {
        position: relative;
    }

    .btn-add-to-fav {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 10;
        background: white;
        border: 1px solid #ff4757;
        border-radius: 50%;
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        color: #ff4757; /* Màu đỏ trái tim */
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-add-to-fav.is-favorited {
        background: #ff4757;
        color: #fff;
    }

    .btn-add-to-fav:hover {
            background: #ff4757;
            color: white;
            transform: scale(1.1);
        }

        .btn-add-to-fav i {
            font-size: 1.2rem;
        }
</style>
<script>
    $(document).on("click", ".btn-remove-to-fav", function () {

        const button = $(this);
        const productId = button.data("id");

        $.ajax({
            url: '/Fav/RemoveFromFav',
            type: 'POST',
            data: { productid: productId },

            success: function (res) {

                if (res.success) {

                    button.closest(".col-lg-3")
                        .fadeOut(300, function () {
                            $(this).remove();
                        });

                } else {
                    alert(res.message);
                }
            },

            error: function () {
                alert("Có lỗi xảy ra!");
            }
        });

    });
</script>