<style>
/* ===== RESET & BASE ===== */
.pg *{box-sizing:border-box}

/* ===== LAYOUT ===== */
.pg{
    display:grid;
    grid-template-columns:230px minmax(0,1fr);
    gap:24px;
    max-width:980px;
    margin:0 auto;
    padding:32px 20px 60px;
    align-items:start;
}

/* ===== SIDEBAR ===== */
.pg-sidebar{
    background:#fff;
    border:1px solid #f0f0f0;
    border-radius:16px;
    padding:22px;
    box-shadow:0 2px 16px rgba(0,0,0,0.05);
    position:sticky;
    top:90px;
}

.sb-user{
    display:flex;
    align-items:center;
    gap:12px;
    padding-bottom:18px;
    border-bottom:1px solid #f3f4f6;
    margin-bottom:14px;
}

.sb-av{
    width:50px;height:50px;
    border-radius:50%;
    background:linear-gradient(135deg,#1a1a2e,#0f3460);
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-size:20px;font-weight:600;
    flex-shrink:0;
}

.sb-name{font-size:14px;font-weight:600;color:#111827;line-height:1.3}
.sb-role{
    display:inline-flex;align-items:center;gap:4px;
    background:#f3f4f6;border:1px solid #e5e7eb;
    border-radius:99px;padding:2px 8px;
    font-size:11px;color:#6b7280;margin-top:4px;
}

.sb-nav{display:flex;flex-direction:column;gap:2px}

.sb-link{
    display:flex;align-items:center;gap:9px;
    padding:10px 12px;
    border-radius:10px;
    font-size:13px;font-weight:500;
    color:#6b7280;
    text-decoration:none;
    border:none;background:none;
    width:100%;text-align:left;
    cursor:pointer;
    transition:all 0.15s ease;
    font-family:inherit;
}
.sb-link i{font-size:16px;flex-shrink:0}
.sb-link:hover{background:#f1f5f9;color:#1a1a2e;text-decoration:none}
.sb-link.active{background:linear-gradient(135deg,#1a1a2e,#0f3460);color:#fff}
.sb-link.sb-logout{color:#ef4444}
.sb-link.sb-logout:hover{background:#fef2f2;color:#dc2626}

.sb-divider{height:1px;background:#f3f4f6;margin:10px 0}

/* ===== MAIN CONTENT ===== */
.pg-main{display:flex;flex-direction:column;gap:0}

/* ===== CARD ===== */
.pf-card{
    background:#fff;
    border:1px solid #f0f0f0;
    border-radius:16px;
    box-shadow:0 2px 16px rgba(0,0,0,0.05);
    overflow:hidden;
}

.pf-card-head{
    background:linear-gradient(135deg,#1a1a2e,#0f3460);
    color:#fff;
    padding:15px 24px;
    font-size:14px;font-weight:600;
    display:flex;align-items:center;gap:8px;
}
.pf-card-head i{font-size:16px;opacity:0.85}

.pf-card-body{padding:28px 24px}

/* ===== AVATAR SECTION ===== */
.pf-av-section{
    text-align:center;
    padding-bottom:22px;
    border-bottom:1px solid #f3f4f6;
    margin-bottom:22px;
}

.pf-av-lg{
    width:76px;height:76px;
    border-radius:50%;
    background:linear-gradient(135deg,#1a1a2e,#0f3460);
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-size:28px;font-weight:600;
    margin:0 auto 10px;
}

.pf-av-name{font-size:15px;font-weight:600;color:#111827;margin-bottom:5px}
.pf-av-badge{
    display:inline-flex;align-items:center;gap:5px;
    background:#f3f4f6;border:1px solid #e5e7eb;
    border-radius:99px;padding:4px 12px;
    font-size:12px;color:#6b7280;
}

/* ===== SECTION DIVIDER ===== */
.pf-divider{
    font-size:11px;font-weight:600;color:#9ca3af;
    text-transform:uppercase;letter-spacing:0.06em;
    margin:0 0 14px;
    padding-bottom:8px;
    border-bottom:1px solid #f3f4f6;
}
.pf-divider-mt{margin-top:20px}

/* ===== FORM GRID ===== */
.pf-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.pf-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-top:14px}
.pf-full{grid-column:1/-1}

.pf-field{display:flex;flex-direction:column}

.pf-label{
    font-size:11px;font-weight:600;
    color:#6b7280;
    text-transform:uppercase;letter-spacing:0.05em;
    margin-bottom:6px;
}

.pf-input{
    height:40px;
    border:1px solid #e5e7eb;
    border-radius:10px;
    padding:0 14px;
    font-size:14px;color:#111827;
    background:#fff;
    transition:all 0.2s;
    outline:none;
    font-family:inherit;
    width:100%;
}
.pf-input:focus{border-color:#0f3460;box-shadow:0 0 0 3px rgba(15,52,96,0.08)}
.pf-input:disabled,.pf-input.pf-disabled{background:#f9fafb;color:#9ca3af;cursor:not-allowed}
.pf-input.pf-select{cursor:pointer}
.pf-input.pf-textarea{height:auto;min-height:80px;padding:10px 14px;resize:vertical}

.pf-hint{font-size:11px;color:#9ca3af;margin-top:4px}

/* ===== ADDRESS PREVIEW ===== */
.pf-preview{
    display:none;
    align-items:flex-start;gap:10px;
    background:#f8fafc;
    border:1px dashed #cbd5e1;
    border-radius:10px;
    padding:12px 16px;
    font-size:13px;color:#374151;
    margin-top:6px;
}
.pf-preview i{color:#dc2626;flex-shrink:0;margin-top:2px;font-size:15px}

/* ===== PASSWORD ===== */
.pf-pw-wrap{position:relative}
.pf-pw-wrap .pf-input{padding-right:44px}

.pf-pw-eye{
    position:absolute;right:13px;top:50%;
    transform:translateY(-50%);
    background:none;border:none;
    color:#9ca3af;cursor:pointer;
    font-size:16px;padding:0;line-height:1;
}
.pf-pw-eye:hover{color:#0f3460}

.pf-strength-wrap{margin-top:8px;display:flex;align-items:center;gap:10px}
.pf-strength-bg{
    flex:1;height:5px;
    background:#e5e7eb;border-radius:99px;overflow:hidden;
}
.pf-strength-fill{
    height:100%;width:0;border-radius:99px;
    transition:width 0.3s ease,background 0.3s ease;
}
.pf-strength-text{font-size:12px;font-weight:600;min-width:70px}

.pf-match{
    font-size:12px;margin-top:6px;
    display:flex;align-items:center;gap:4px;
}

/* ===== SECURITY NOTICE ===== */
.pf-security{
    display:flex;align-items:center;gap:10px;
    background:#eff6ff;border:1px solid #bfdbfe;
    border-radius:10px;padding:12px 16px;
    font-size:13px;color:#1d4ed8;
    margin-bottom:20px;
}
.pf-security i{font-size:18px;flex-shrink:0}

/* ===== ACTIONS ===== */
.pf-actions{
    display:flex;justify-content:flex-end;align-items:center;gap:10px;
    margin-top:24px;padding-top:18px;
    border-top:1px solid #f3f4f6;
}

.pf-btn-save{
    display:inline-flex;align-items:center;gap:6px;
    background:linear-gradient(135deg,#1a1a2e,#0f3460);
    color:#fff;border:none;border-radius:10px;
    padding:10px 22px;font-size:13px;font-weight:600;
    cursor:pointer;transition:opacity 0.2s;
    font-family:inherit;
}
.pf-btn-save:hover{opacity:0.88}

.pf-btn-cancel{
    display:inline-flex;align-items:center;gap:6px;
    background:#fff;color:#6b7280;
    border:1px solid #e5e7eb;border-radius:10px;
    padding:9px 18px;font-size:13px;font-weight:500;
    cursor:pointer;transition:all 0.15s;
    font-family:inherit;
}
.pf-btn-cancel:hover{background:#f3f4f6;color:#374151}

/* ===== FEEDBACK MESSAGES ===== */
.pf-msg{font-size:13px;margin-top:14px;display:flex;align-items:center;gap:6px;padding:10px 14px;border-radius:8px}
.pf-msg.success{background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0}
.pf-msg.error{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}

/* ===== RESPONSIVE ===== */
    @@media(max-width:768px){
    .pg{grid-template-columns:1fr;padding:16px 16px 40px}
    .pg-sidebar{position:static}
    .pf-grid,.pf-grid-3{grid-template-columns:1fr}
}
</style>

<h2 class="sr-only">Trang quản lý tài khoản người dùng</h2>

<div class="pg">

    <!-- ===== SIDEBAR ===== -->
    <aside class="pg-sidebar">
        <div class="sb-user">
            <div class="sb-av">@Model.Name?.Substring(0, 1).ToUpper()</div>
            <div>
                <div class="sb-name">@Model.Name</div>
                <div class="sb-role"><i class="ri-star-line" style="font-size:11px"></i> Thành viên</div>
            </div>
        </div>

        <nav class="sb-nav">
            <button type="button" class="sb-link active" onclick="switchTab('info',this)">
                <i class="ri-user-line"></i> Thông tin cá nhân
            </button>
            <button type="button" class="sb-link" onclick="switchTab('address',this)">
                <i class="ri-map-pin-line"></i> Địa chỉ giao hàng
            </button>
            <button type="button" class="sb-link" onclick="switchTab('password',this)">
                <i class="ri-lock-line"></i> Đổi mật khẩu
            </button>

            <div class="sb-divider"></div>

            <form id="logoutForm" method="post" action="@Url.Action("Logout","UserAuth")" style="margin:0">
                @Html.AntiForgeryToken()
                <button type="submit" class="sb-link sb-logout" style="border:none;background:none;padding:10px 12px;text-align:left;width:100%;font-family:inherit;cursor:pointer">
                    <i class="ri-logout-box-line"></i> Đăng xuất
                </button>
            </form>
        </nav>
    </aside>

    <!-- ===== MAIN ===== -->
    <main class="pg-main">
        <div class="tab-panels">

            <!-- ── Tab: Thông tin cá nhân ── -->
            <div id="panel-info" class="show">
                <div class="pf-card">
                    <div class="pf-card-head">
                        <i class="ri-edit-line"></i> Chỉnh sửa thông tin
                    </div>
                    <div class="pf-card-body">

                        <!-- Avatar -->
                        <div class="pf-av-section">
                            <div class="pf-av-lg">@Model.Name?.Substring(0,1).ToUpper()</div>
                            <div class="pf-av-name">@Model.Name</div>
                            <div class="pf-av-badge">
                                <i class="ri-star-line" style="font-size:12px"></i> Thành viên TheEgo Shop
                            </div>
                        </div>

                        <form id="profileForm">
                            <div class="pf-divider">Thông tin liên hệ</div>

                            <div class="pf-grid">
                                <div class="pf-field">
                                    <label class="pf-label">Họ và tên</label>
                                    <input type="text" id="name" name="name"
                                           class="pf-input" value="@Model.Name"
                                           placeholder="Nhập họ và tên" />
                                </div>

                                <div class="pf-field">
                                    <label class="pf-label">
                                        Email <i class="ri-lock-line" style="font-size:11px;vertical-align:1px"></i>
                                    </label>
                                    <input type="email" class="pf-input pf-disabled"
                                           value="@Model.Email" disabled />
                                    <div class="pf-hint">Email không thể thay đổi</div>
                                </div>

                                <div class="pf-field">
                                    <label class="pf-label">Số điện thoại</label>
                                    <input type="tel" id="contactNo" name="contactNo"
                                           class="pf-input" value="@Model.ContactNo"
                                           placeholder="0901 234 567" />
                                </div>
                            </div>

                            <div id="message"></div>

                            <div class="pf-actions">
                                <button type="button" class="pf-btn-cancel" onclick="location.reload()">
                                    Hủy
                                </button>
                                <button type="submit" class="pf-btn-save">
                                    <i class="ri-save-line"></i> Lưu thay đổi
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <!-- ── Tab: Địa chỉ giao hàng ── -->
            <div id="panel-address">
                <div class="pf-card">
                    <div class="pf-card-head">
                        <i class="ri-map-pin-line"></i> Địa chỉ giao hàng mặc định
                    </div>
                    <div class="pf-card-body">

                        <form id="addressForm">
                            <div class="pf-divider">Địa chỉ chi tiết</div>

                            <div class="pf-field pf-full" style="margin-bottom:0">
                                <label class="pf-label">Số nhà, tên đường</label>
                                <textarea id="addressDetail" name="address"
                                          class="pf-input pf-textarea"
                                          placeholder="VD: 123 Đường Lê Lợi"
                                          data-current="@Model.Address">@Model.Address</textarea>
                                <small style="color:#666;font-size:11px;display:block;margin-top:4px;">Current: @(string.IsNullOrEmpty(Model?.Address) ? "(trống)" : Model.Address)</small>
                            </div>

                            <div class="pf-grid">
                                <div class="pf-field">
                                    <label class="pf-label">Tỉnh / Thành phố</label>
                                    <select id="province" name="city" class="pf-input pf-select"
                                            data-current="@Model.City">
                                        <option value="">-- Chọn Tỉnh/Thành --</option>
                                    </select>
                                    <small style="color:#666;font-size:11px;display:block;margin-top:4px;">Current: @(string.IsNullOrEmpty(Model?.City) ? "(trống)" : Model.City)</small>
                                </div>
                                <div class="pf-field">
                                    <label class="pf-label">Phường / Xã</label>
                                    <select id="commune" name="ward" class="pf-input pf-select"
                                            data-current="@Model.Ward">
                                        <option value="">-- Chọn Phường/Xã --</option>
                                    </select>
                                    <small style="color:#666;font-size:11px;display:block;margin-top:4px;">Current: @(string.IsNullOrEmpty(Model?.Ward) ? "(trống)" : Model.Ward)</small>
                                </div>
                            </div>

                            <!-- Preview -->
                            <div style="margin-top:18px">
                                <div class="pf-label" style="display:flex;align-items:center;gap:5px;margin-bottom:6px">
                                    <i class="ri-eye-line" style="font-size:13px"></i> Xem trước địa chỉ
                                </div>
                                <div class="pf-preview" id="addressPreview">
                                    <i class="ri-map-pin-fill"></i>
                                    <span id="previewText"></span>
                                </div>
                            </div>

                            <div id="addressMessage"></div>

                            <div class="pf-actions">
                                <button type="button" class="pf-btn-cancel" onclick="location.reload()">
                                    Hủy
                                </button>
                                <button type="submit" class="pf-btn-save">
                                    <i class="ri-save-line"></i> Lưu địa chỉ
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <!-- ── Tab: Đổi mật khẩu ── -->
            <div id="panel-password">
                <div class="pf-card">
                    <div class="pf-card-head">
                        <i class="ri-lock-password-line"></i> Thay đổi mật khẩu
                    </div>
                    <div class="pf-card-body">

                        <div class="pf-security">
                            <i class="ri-shield-check-line"></i>
                            <span>Mật khẩu mới phải có ít nhất <strong>8 ký tự</strong>. Nên kết hợp chữ hoa, số và ký tự đặc biệt.</span>
                        </div>

                        <form id="passwordForm">
                            <div class="pf-divider">Mật khẩu hiện tại</div>

                            <div class="pf-field" style="max-width:380px;margin-bottom:4px">
                                <label class="pf-label">Mật khẩu hiện tại</label>
                                <div class="pf-pw-wrap">
                                    <input type="password" id="currentPassword" name="currentPassword"
                                           class="pf-input" placeholder="••••••••" />
                                    <button type="button" class="pf-pw-eye" onclick="togglePassword(this)">
                                        <i class="ri-eye-off-line"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="pf-divider pf-divider-mt">Mật khẩu mới</div>

                            <div class="pf-grid">
                                <div class="pf-field">
                                    <label class="pf-label">Mật khẩu mới</label>
                                    <div class="pf-pw-wrap">
                                        <input type="password" id="newPassword" name="newPassword"
                                               class="pf-input" placeholder="••••••••" />
                                        <button type="button" class="pf-pw-eye" onclick="togglePassword(this)">
                                            <i class="ri-eye-off-line"></i>
                                        </button>
                                    </div>
                                    <div class="pf-strength-wrap">
                                        <div class="pf-strength-bg">
                                            <div id="passwordStrength" class="pf-strength-fill"></div>
                                        </div>
                                        <span id="strengthText" class="pf-strength-text"></span>
                                    </div>
                                </div>

                                <div class="pf-field">
                                    <label class="pf-label">Xác nhận mật khẩu mới</label>
                                    <div class="pf-pw-wrap">
                                        <input type="password" id="confirmPassword" name="confirmPassword"
                                               class="pf-input" placeholder="••••••••" />
                                        <button type="button" class="pf-pw-eye" onclick="togglePassword(this)">
                                            <i class="ri-eye-off-line"></i>
                                        </button>
                                    </div>
                                    <div id="matchStatus" class="pf-match"></div>
                                </div>
                            </div>

                            <div id="passwordMessage"></div>

                            <div class="pf-actions">
                                <button type="button" class="pf-btn-cancel" onclick="resetPasswordForm()">
                                    Hủy
                                </button>
                                <button type="submit" class="pf-btn-save">
                                    <i class="ri-save-line"></i> Cập nhật mật khẩu
                                </button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
/* ===== TAB SWITCHING ===== */
function switchTab(name, btn) {
    document.querySelectorAll('.tab-panels > div').forEach(p => p.classList.remove('show'));
    document.querySelectorAll('.sb-link').forEach(b => b.classList.remove('active'));
    document.getElementById('panel-' + name).classList.add('show');
    btn.classList.add('active');
    if (name === 'address') loadProvinces();
}

/* ===== TOGGLE PASSWORD VISIBILITY ===== */
function togglePassword(btn) {
    const input = btn.closest('.pf-pw-wrap').querySelector('input');
    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    btn.querySelector('i').className = isHidden ? 'ri-eye-line' : 'ri-eye-off-line';
}

/* ===== ADDRESS API ===== */
let addressDataLoaded = false; // Flag to track if API data is loaded

async function loadProvinces() {
    try {
        addressDataLoaded = false; // Mark as loading
        const res  = await fetch('/api/address/provinces');
        const data = await res.json();
        const sel  = document.getElementById('province');
        const currentCity = (sel.dataset.current || '').trim();
        console.log('Current city from data:', currentCity);
        sel.innerHTML = '<option value="">-- Chọn Tỉnh/Thành --</option>';
        data.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.code;
            opt.text = p.name;
            opt.dataset.name = p.name.trim();
            sel.appendChild(opt);
        });
        if (currentCity) {
            const option = Array.from(sel.options).find(o => {
                const dataName = (o.dataset.name || '').trim();
                return dataName === currentCity;
            });
            console.log('Found province option:', option ? option.text : 'NOT FOUND');
            if (option) {
                option.selected = true;
                await loadCommunes(option.value);
            } else {
                console.log('Available options:', Array.from(sel.options).map(o => o.dataset.name));
            }
        }
        addressDataLoaded = true; // Mark as loaded
    } catch(e) { 
        console.error('Load provinces:', e);
        addressDataLoaded = false;
    }
}

async function loadCommunes(code) {
    try {
        const res  = await fetch('/api/address/provinces/' + code + '/communes');
        const data = await res.json();
        const sel  = document.getElementById('commune');
        const currentWard = (sel.dataset.current || '').trim();
        console.log('Current ward from data:', currentWard);
        sel.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
        data.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.code;
            opt.text = c.name;
            opt.dataset.name = c.name.trim();
            sel.appendChild(opt);
        });
        if (currentWard) {
            const option = Array.from(sel.options).find(o => {
                const dataName = (o.dataset.name || '').trim();
                return dataName === currentWard;
            });
            console.log('Found commune option:', option ? option.text : 'NOT FOUND');
            if (option) {
                option.selected = true;
            } else {
                console.log('Available commune options:', Array.from(sel.options).map(o => o.dataset.name));
            }
        }
    } catch(e) { console.error('Load communes:', e); }
}

document.getElementById('province').addEventListener('change', e => loadCommunes(e.target.value));
document.getElementById('commune').addEventListener('change', updateAddressPreview);
document.getElementById('addressDetail').addEventListener('input', updateAddressPreview);

function updateAddressPreview() {
    const prov = document.getElementById('province');
    const comm = document.getElementById('commune');
    const addr = document.getElementById('addressDetail').value.trim();
    const pTxt = prov.options[prov.selectedIndex]?.text;
    const cTxt = comm.options[comm.selectedIndex]?.text;
    const box  = document.getElementById('addressPreview');

    if (addr && pTxt && cTxt &&
        pTxt !== '-- Chọn Tỉnh/Thành --' &&
        cTxt !== '-- Chọn Phường/Xã --') {
        document.getElementById('previewText').textContent = addr + ', ' + cTxt + ', ' + pTxt;
        box.style.display = 'flex';
    } else {
        box.style.display = 'none';
    }
}

/* ===== PASSWORD STRENGTH ===== */
document.getElementById('newPassword').addEventListener('input', updatePasswordStrength);
document.getElementById('confirmPassword').addEventListener('input', checkPasswordMatch);

function updatePasswordStrength() {
    const pwd = document.getElementById('newPassword').value;
    let score = 0;
    if (pwd.length >= 8)           score += 20;
    if (/[a-z]/.test(pwd))         score += 20;
    if (/[A-Z]/.test(pwd))         score += 20;
    if (/[0-9]/.test(pwd))         score += 20;
    if (/[^A-Za-z0-9]/.test(pwd))  score += 20;

    const bar   = document.getElementById('passwordStrength');
    const label = document.getElementById('strengthText');
    bar.style.width = score + '%';

    if (score < 40) {
        bar.style.background = '#ef4444'; label.textContent = 'Yếu'; label.style.color = '#ef4444';
    } else if (score < 80) {
        bar.style.background = '#f97316'; label.textContent = 'Trung bình'; label.style.color = '#f97316';
    } else {
        bar.style.background = '#22c55e'; label.textContent = 'Mạnh'; label.style.color = '#22c55e';
    }
    checkPasswordMatch();
}

function checkPasswordMatch() {
    const pwd     = document.getElementById('newPassword').value;
    const confirm = document.getElementById('confirmPassword').value;
    const status  = document.getElementById('matchStatus');
    if (!pwd && !confirm) { status.innerHTML = ''; return; }
    if (confirm) {
        if (pwd === confirm) {
            status.innerHTML = '<i class="ri-check-line" style="color:#22c55e;font-size:14px"></i><span style="color:#22c55e">Mật khẩu khớp</span>';
        } else {
            status.innerHTML = '<i class="ri-close-line" style="color:#ef4444;font-size:14px"></i><span style="color:#ef4444">Mật khẩu không khớp</span>';
        }
    }
}

function resetPasswordForm() {
    document.getElementById('passwordForm').reset();
    document.getElementById('passwordStrength').style.width = '0%';
    document.getElementById('strengthText').textContent = '';
    document.getElementById('matchStatus').innerHTML = '';
}

function showMsg(id, type, text) {
    document.getElementById(id).innerHTML =
        '<div class="pf-msg ' + type + '"><i class="ri-' +
        (type === 'success' ? 'check' : 'close') + '-line"></i>' + text + '</div>';
}

/* ===== FORM SUBMISSIONS ===== */
document.addEventListener('DOMContentLoaded', function() {
    console.log('Document ready');

    const provinceElem = document.getElementById('province');
    const communeElem = document.getElementById('commune');
    const addressDetailElem = document.getElementById('addressDetail');
    const newPasswordElem = document.getElementById('newPassword');
    const confirmPasswordElem = document.getElementById('confirmPassword');

    if (provinceElem) provinceElem.addEventListener('change', e => loadCommunes(e.target.value));
    if (communeElem) communeElem.addEventListener('change', updateAddressPreview);
    if (addressDetailElem) addressDetailElem.addEventListener('input', updateAddressPreview);
    if (newPasswordElem) newPasswordElem.addEventListener('input', updatePasswordStrength);
    if (confirmPasswordElem) confirmPasswordElem.addEventListener('input', checkPasswordMatch);

    const profileForm = document.getElementById('profileForm');
    if (profileForm) {
        profileForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('name')?.value || '';
            const contactNo = document.getElementById('contactNo')?.value || '';
            const data = { Name: name, ContactNo: contactNo };

            fetch('/userauth/updateprofile', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    showMsg('message', 'success', 'Cập nhật thành công');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showMsg('message', 'error', res.message || 'Cập nhật thất bại');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                showMsg('message', 'error', 'Cập nhật thất bại: ' + err.message);
            });
        });
    }

    const addressForm = document.getElementById('addressForm');
    if (addressForm) {
        addressForm.addEventListener('submit', function(e) {
            e.preventDefault();

            if (!addressDataLoaded) {
                showMsg('addressMessage', 'error', 'Dữ liệu địa chỉ vẫn đang tải, vui lòng chờ...');
                return;
            }

            const provinceSelect = document.getElementById('province');
            const communeSelect = document.getElementById('commune');
            const addressDetailInput = document.getElementById('addressDetail');

            if (!provinceSelect.value || provinceSelect.selectedIndex === 0) {
                showMsg('addressMessage', 'error', 'Vui lòng chọn tỉnh/thành phố');
                return;
            }

            if (!communeSelect.value || communeSelect.selectedIndex === 0) {
                showMsg('addressMessage', 'error', 'Vui lòng chọn phường/xã');
                return;
            }

            const addressDetail = (addressDetailInput.value || '').trim();
            if (!addressDetail) {
                showMsg('addressMessage', 'error', 'Vui lòng nhập địa chỉ chi tiết');
                return;
            }

            const provinceName = (provinceSelect.options[provinceSelect.selectedIndex]?.text || '').trim();
            const communeName = (communeSelect.options[communeSelect.selectedIndex]?.text || '').trim();

            if (provinceName.includes('--') || communeName.includes('--')) {
                showMsg('addressMessage', 'error', 'Vui lòng chọn đầy đủ tỉnh và xã');
                return;
            }

            const data = {
                City: provinceName,
                Ward: communeName,
                Address: addressDetail
            };

            fetch('/userauth/updateprofile', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    showMsg('addressMessage', 'success', 'Cập nhật địa chỉ thành công');
                    setTimeout(() => {
                        addressDataLoaded = false;
                        location.reload();
                    }, 1000);
                } else {
                    showMsg('addressMessage', 'error', res.message || 'Cập nhật thất bại');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                showMsg('addressMessage', 'error', 'Lỗi kết nối: ' + err.message);
            });
        });
    }

    const passwordForm = document.getElementById('passwordForm');
    if (passwordForm) {
        passwordForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const newPwd = document.getElementById('newPassword')?.value || '';
            const confirmPwd = document.getElementById('confirmPassword')?.value || '';
            if (newPwd !== confirmPwd) {
                showMsg('passwordMessage', 'error', 'Mật khẩu xác nhận không khớp');
                return;
            }

            const data = {
                CurrentPassword: document.getElementById('currentPassword')?.value || '',
                NewPassword: newPwd,
                ConfirmPassword: confirmPwd
            };

            fetch('/userauth/changepassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    showMsg('passwordMessage', 'success', 'Đổi mật khẩu thành công, đang chuyển hướng...');
                    setTimeout(() => location.href = '/userauth/login', 2000);
                } else {
                    showMsg('passwordMessage', 'error', res.message || 'Đổi mật khẩu thất bại');
                }
            })
            .catch(err => {
                console.error('Error:', err);
                showMsg('passwordMessage', 'error', 'Lỗi kết nối');
            });
        });
    }
});
</script>

