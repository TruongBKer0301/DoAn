@model LapTopBD.Models.ViewModels.Users.PolicyPageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="container-fluid hero-cart mb-5">
    <div class="hero-inner">
        <h1 class="hero-title">@Model.PageTitle</h1>
        <div class="hero-divider"></div>
        <div class="hero-breadcrumb">
            <a href="@Url.Action("Index", "Home")">Trang Chủ >></a>
            <i class="ti ti-chevron-right"></i>
            <span class="hero-bc-cur">@Model.PageTitle</span>
        </div>
    </div>
</div>
<div class="container py-4 policy-page-content">
    @Html.Raw(Model.HtmlContent)
</div>

<style>
    .policy-page-content {
        max-width: 980px;
        line-height: 1.75;
        font-size: 15px;
    }

    .policy-page-content h2,
    .policy-page-content h3 {
        margin-top: 1.25rem;
        margin-bottom: 0.75rem;
        font-weight: 700;
    }

    .policy-page-content ul,
    .policy-page-content ol {
        padding-left: 1.2rem;
    }

    .policy-page-content p {
        margin-bottom: 0.75rem;
    }
</style>
