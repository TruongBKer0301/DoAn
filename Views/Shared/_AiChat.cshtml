@*
    AI Chatbox Partial - Professional UI
    Requires:
    - Font Awesome
    - Bootstrap
*@

<div id="ai-chatbox" class="ai-chatbox is-collapsed">

    <button type="button" class="ai-chat-launcher" id="aiChatLauncher" aria-label="Mở AI chat">
        <i class="fas fa-robot"></i>
    </button>

    <!-- HEADER -->
    <div class="ai-chat-header" id="ai-chat-toggle">

        <div class="ai-header-info">

            <div class="ai-avatar">
                <i class="fas fa-robot"></i>
            </div>

            <div>
                <div class="ai-title">
                    AI Tư Vấn
                </div>

                <div class="ai-status">
                    <span class="dot"></span>
                    Đang hoạt động
                </div>
            </div>

        </div>

        <div style="display:flex;align-items:center;gap:8px;">
            <button id="aiClearHistory" title="Xóa lịch sử chat"
                style="background:rgba(255,255,255,.15);border:none;border-radius:8px;color:#fff;font-size:13px;padding:4px 8px;cursor:pointer;opacity:.8;">
                <i class="fas fa-trash-alt"></i>
            </button>
            <div class="ai-toggle-icon" id="toggleIcon">−</div>
        </div>

    </div>

    <!-- BODY -->
    <div class="ai-chat-body" id="aiChatBody">

        <!-- MESSAGES -->
        <div id="aiMessages" class="ai-messages">

            <div class="ai-message assistant">
                <div class="bubble">
                    Xin chào 👋 <br />
                    Tôi có thể giúp bạn chọn laptop phù hợp với nhu cầu và ngân sách.
                </div>
            </div>

        </div>

        <!-- INPUT -->
        <div class="ai-input-row">

            <input id="aiInput"
                   type="text"
                   class="form-control"
                     placeholder="Hỏi về các sản phẩm của shop..." />

            <button id="aiSend">
                <i class="fas fa-paper-plane"></i>
            </button>

        </div>

    </div>

</div>

<style>

    .ai-chatbox{
        position:fixed;
        right:20px;
        bottom:30px;
        width:360px;
        max-width:92vw;
        z-index:3000;
        font-family:Poppins,sans-serif;
        animation:fadeUp .35s ease;
    }

    .ai-chatbox.is-collapsed{
        width:60px;
        height:60px;
    }

    @@keyframes fadeUp{
        from{
            opacity:0;
            transform:translateY(20px);
        }
        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    .ai-chat-header{
        background:linear-gradient(135deg,#1a1a2e,#0f3460);
        color:#fff;
        padding:14px 16px;
        border-radius:18px 18px 0 0;
        display:flex;
        align-items:center;
        justify-content:space-between;
        cursor:default;
        box-shadow:0 10px 30px rgba(15,52,96,.25);
    }

    .ai-chatbox.is-collapsed .ai-chat-header{
        display:none;
    }

    .ai-chat-launcher{
        width:60px;
        height:60px;
        border:none;
        border-radius:50%;
        display:flex;
        align-items:center;
        justify-content:center;
        background:linear-gradient(135deg,#1a1a2e,#0f3460);
        color:#fff;
        box-shadow:0 10px 30px rgba(15,52,96,.28);
        cursor:pointer;
        font-size:22px;
        position:absolute;
        right:0;
        bottom:0;
    }

    .ai-chat-launcher:hover{
        transform:translateY(-2px);
    }

    .ai-header-info{
        display:flex;
        align-items:center;
        gap:12px;
    }

    .ai-avatar{
        width:42px;
        height:42px;
        border-radius:50%;
        background:rgba(255,255,255,.15);
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:18px;
    }

    .ai-title{
        font-size:15px;
        font-weight:700;
        line-height:1.2;
    }

    .ai-status{
        font-size:12px;
        opacity:.9;
        display:flex;
        align-items:center;
        gap:6px;
        margin-top:2px;
    }

    .dot{
        width:8px;
        height:8px;
        background:#22c55e;
        border-radius:50%;
    }

    .ai-toggle-icon{
        font-size:24px;
        font-weight:300;
        cursor:pointer;
        padding-left:10px;
    }

    .ai-chat-body{
        background:rgba(255,255,255,.98);
        backdrop-filter:blur(10px);
        border:1px solid #e5e7eb;
        border-top:none;
        border-radius:0 0 18px 18px;
        overflow:hidden;
        display:flex;
        flex-direction:column;
        height:500px;
        box-shadow:0 10px 35px rgba(0,0,0,.12);
    }

    .ai-chatbox.is-collapsed .ai-chat-body{
        display:none;
    }

    .ai-messages{
        flex:1;
        overflow-y:auto;
        padding:16px;
        background:#f8fafc;
        scroll-behavior:smooth;
    }

    .ai-messages::-webkit-scrollbar{
        width:6px;
    }

    .ai-messages::-webkit-scrollbar-thumb{
        background:#cbd5e1;
        border-radius:20px;
    }

    .ai-message{
        display:flex;
        margin-bottom:14px;
        animation:fadeMessage .25s ease;
    }

    @@keyframes fadeMessage{
        from{
            opacity:0;
            transform:translateY(8px);
        }
        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    .ai-message.user{
        justify-content:flex-end;
    }

    .ai-message.assistant{
        justify-content:flex-start;
    }

    .bubble{
        max-width:80%;
        padding:12px 14px;
        border-radius:16px;
        font-size:13px;
        line-height:1.6;
        box-shadow:0 2px 8px rgba(0,0,0,.05);
        word-break:break-word;
    }

    /* ── Product suggestion card (gợi ý) ──────────────────────────── */
    .ai-product-card{
        border:1px solid #e2e8f0;
        border-radius:16px;
        padding:12px 14px;
        background:linear-gradient(180deg,#fff 0%,#f8fbff 100%);
        box-shadow:0 8px 22px rgba(15,23,42,.06);
        margin-top:8px;
    }

    .ai-product-card__top{
        display:flex;
        align-items:flex-start;
        gap:12px;
    }

    .ai-product-thumb{
        width:72px;
        height:72px;
        flex:0 0 72px;
        border-radius:14px;
        border:1px solid #e2e8f0;
        object-fit:cover;
        background:#f8fafc;
        box-shadow:0 4px 10px rgba(15,23,42,.06);
    }

    .ai-product-thumb--placeholder{
        display:flex;
        align-items:center;
        justify-content:center;
        color:#94a3b8;
        font-size:11px;
        text-align:center;
        padding:8px;
    }

    .ai-product-title{
        color:#2563eb;
        font-weight:700;
        font-size:14px;
        line-height:1.35;
        margin-bottom:4px;
    }

    .ai-product-main{
        flex:1;
        min-width:0;
    }

    .ai-product-price{
        color:#0f172a;
        font-weight:700;
        font-size:13px;
    }

    .ai-product-specs{
        display:flex;
        flex-direction:column;
        gap:6px;
        margin-top:10px;
        color:#334155;
        font-size:12px;
        line-height:1.45;
    }

    .ai-product-spec{
        background:#fff;
        border:1px solid #e2e8f0;
        border-radius:10px;
        padding:8px 10px;
    }

    .ai-product-desc{
        margin-top:8px;
        color:#475569;
        font-size:13px;
        line-height:1.4;
    }

    .ai-product-name{
        color:#2563eb;
        font-weight:600;
    }

    .ai-buy-now{
        color:#dc2626;
        font-weight:700;
        background:#fee2e2;
        padding:0 6px;
        border-radius:999px;
    }

    .ai-buy-link{
        display:block;
        margin-top:10px;
        padding:8px 14px;
        border-radius:12px;
        background:linear-gradient(135deg,#2563eb,#1d4ed8);
        color:#fff !important;
        text-decoration:none !important;
        font-weight:700;
        font-size:13px;
        box-shadow:0 8px 18px rgba(29,78,216,.18);
        transition:transform .15s ease,box-shadow .15s ease,opacity .12s ease;
        border:1px solid rgba(255,255,255,.06);
        text-align:center;
    }

    .ai-buy-link:hover{
        transform:translateY(-3px);
        box-shadow:0 14px 30px rgba(29,78,216,.22);
        opacity:1;
    }

    /* ── NEW: Product detail box ───────────────────────────────────── */
    .ai-detail-box{
        border:1px solid #bfdbfe;
        border-radius:16px;
        overflow:hidden;
        background:#fff;
        box-shadow:0 8px 24px rgba(15,23,42,.08);
        width:100%;
        max-width:310px;
    }

    .ai-detail-box__img{
        width:100%;
        height:160px;
        object-fit:contain;
        background:#f8fafc;
        border-bottom:1px solid #e2e8f0;
        padding:8px;
    }

    .ai-detail-box__img--placeholder{
        width:100%;
        height:100px;
        display:flex;
        align-items:center;
        justify-content:center;
        background:#f1f5f9;
        color:#94a3b8;
        font-size:12px;
        border-bottom:1px solid #e2e8f0;
    }

    .ai-detail-box__body{
        padding:12px 14px;
    }

    .ai-detail-box__name{
        color:#1e40af;
        font-weight:700;
        font-size:14px;
        line-height:1.35;
        margin-bottom:6px;
    }

    .ai-detail-box__price{
        color:#dc2626;
        font-weight:800;
        font-size:15px;
        margin-bottom:10px;
    }

    .ai-detail-box__specs{
        display:flex;
        flex-direction:column;
        gap:5px;
        margin-bottom:10px;
    }

    .ai-detail-box__spec{
        display:flex;
        gap:6px;
        font-size:12px;
        color:#374151;
        background:#f8fafc;
        border:1px solid #e5e7eb;
        border-radius:8px;
        padding:6px 9px;
        line-height:1.4;
    }

    .ai-detail-box__spec b{
        color:#1e3a5f;
        white-space:nowrap;
    }

    .ai-detail-box__desc{
        font-size:12px;
        color:#6b7280;
        line-height:1.5;
        margin-bottom:10px;
        border-top:1px solid #f1f5f9;
        padding-top:8px;
    }

    /* ── Common ────────────────────────────────────────────────────── */
    .ai-message.user .bubble{
        background:linear-gradient(135deg,#2563eb,#1d4ed8);
        color:#fff;
        border-bottom-right-radius:4px;
    }

    .ai-message.assistant .bubble{
        background:#fff;
        color:#0f172a;
        border-bottom-left-radius:4px;
    }

    .ai-message.assistant .bubble.bubble--detail{
        background:transparent;
        border:none;
        box-shadow:none;
        padding:0;
        max-width:100%;
    }

    .ai-plain-text{
        white-space:pre-wrap;
    }

    .typing{
        display:flex;
        gap:4px;
        align-items:center;
    }

    .typing span{
        width:6px;
        height:6px;
        background:#94a3b8;
        border-radius:50%;
        animation:typing .9s infinite;
    }

    .typing span:nth-child(2){
        animation-delay:.2s;
    }

    .typing span:nth-child(3){
        animation-delay:.4s;
    }

    @@keyframes typing{
        0%,100%{
            transform:translateY(0);
            opacity:.4;
        }
        50%{
            transform:translateY(-4px);
            opacity:1;
        }
    }

    .ai-input-row{
        display:flex;
        align-items:center;
        gap:10px;
        padding:14px;
        background:#fff;
        border-top:1px solid #f1f5f9;
    }

    .ai-input-row input{
        flex:1;
        border:none;
        background:#f1f5f9;
        border-radius:12px;
        padding:12px 14px;
        font-size:13px;
        outline:none;
        transition:.2s;
    }

    .ai-input-row input:focus{
        background:#fff;
        box-shadow:0 0 0 3px rgba(37,99,235,.12);
    }

    #aiSend{
        width:46px;
        height:46px;
        border:none;
        border-radius:12px;
        background:linear-gradient(135deg,#1a1a2e,#0f3460);
        color:#fff;
        transition:.25s;
    }

    #aiSend:hover{
        transform:translateY(-2px);
        opacity:.92;
    }

    .ai-hidden{
        display:none !important;
    }

</style>

<script>

    const aiMessages = document.getElementById("aiMessages");
    const aiInput = document.getElementById("aiInput");
    const aiSend = document.getElementById("aiSend");
    const aiChatBody = document.getElementById("aiChatBody");
    const toggleIcon = document.getElementById("toggleIcon");
    const aiChatLauncher = document.getElementById("aiChatLauncher");

    // ── localStorage: key lưu lịch sử chat ──────────────────────────────────
    const CHAT_STORAGE_KEY = 'ai_chat_history';
    const CHAT_OPEN_KEY    = 'ai_chat_open';   // trạng thái mở/đóng
    const MAX_HISTORY      = 40; // số tin nhắn tối đa giữ lại

    // Lưu conversation vào localStorage
    function saveHistory(){
        try{
            const trimmed = conversation.slice(-MAX_HISTORY);
            localStorage.setItem(CHAT_STORAGE_KEY, JSON.stringify(trimmed));
        }catch(e){ /* bỏ qua nếu storage bị chặn */ }
    }

    // Xóa toàn bộ lịch sử
    function clearHistory(){
        try{ localStorage.removeItem(CHAT_STORAGE_KEY); }catch(e){}
        conversation.length = 0;
        aiMessages.innerHTML = '';
        // Thêm lại lời chào mặc định
        const greeting = 'Xin chào 👋\nTôi có thể giúp bạn chọn laptop phù hợp với nhu cầu và ngân sách.';
        conversation.push({ role: 'assistant', content: greeting });
        renderSavedMessage('assistant', greeting);
    }

    // Render lại một tin nhắn đã lưu (không push vào conversation nữa)
    function renderSavedMessage(type, text){
        const wrapper = document.createElement("div");
        wrapper.className = `ai-message ${type}`;
        const isDetail   = type === "assistant" && isProductDetailBlock(text);
        const bubbleClass = isDetail ? "bubble bubble--detail" : "bubble";
        wrapper.innerHTML = `
            <div class="${bubbleClass}">
                ${type === "assistant" ? formatAssistantReply(text) : escapeHtml(text)}
            </div>
        `;
        aiMessages.appendChild(wrapper);
    }

    // ── Khởi tạo conversation từ localStorage (nếu có) ──────────────────────
    const conversation = [];
    const GREETING     = 'Xin chào 👋\nTôi có thể giúp bạn chọn laptop phù hợp với nhu cầu và ngân sách.';

    (function initHistory(){
        let loaded = false;
        try{
            const saved = localStorage.getItem(CHAT_STORAGE_KEY);
            if(saved){
                const parsed = JSON.parse(saved);
                if(Array.isArray(parsed) && parsed.length > 0){
                    // Xóa bubble chào mặc định trong DOM (đã render bởi Razor)
                    aiMessages.innerHTML = '';
                    parsed.forEach(function(item){
                        conversation.push(item);
                        renderSavedMessage(item.role === 'assistant' ? 'assistant' : 'user', item.content);
                    });
                    scrollBottom();
                    loaded = true;
                }
            }
        }catch(e){ /* storage lỗi → dùng greeting mặc định */ }

        if(!loaded){
            conversation.push({ role: 'assistant', content: GREETING });
            // DOM đã có bubble chào từ Razor, không cần render thêm
        }

        // Khôi phục trạng thái mở/đóng từ lần trước
        try{
            if(localStorage.getItem(CHAT_OPEN_KEY) === '1'){
                // Mở ngay không animation
                document.getElementById("ai-chatbox").classList.remove("is-collapsed");
                aiChatBody.classList.remove("ai-hidden");
                aiChatLauncher.classList.add("ai-hidden");
                toggleIcon.innerText = "−";
                scrollBottom();
            }
        }catch(e){}
    })();

    function openChatbox() {
        aiChatBody.classList.remove("ai-hidden");
        document.getElementById("ai-chatbox").classList.remove("is-collapsed");
        aiChatLauncher.classList.add("ai-hidden");
        toggleIcon.innerText = "−";
        aiInput?.focus();
        try{ localStorage.setItem(CHAT_OPEN_KEY, '1'); }catch(e){}
    }

    function collapseChatbox() {
        aiChatBody.classList.add("ai-hidden");
        document.getElementById("ai-chatbox").classList.add("is-collapsed");
        aiChatLauncher.classList.remove("ai-hidden");
        toggleIcon.innerText = "+";
        try{ localStorage.setItem(CHAT_OPEN_KEY, '0'); }catch(e){}
    }

    toggleIcon.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        collapseChatbox();
    });

    document.getElementById("aiClearHistory").addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        if(confirm("Xóa toàn bộ lịch sử chat?")) clearHistory();
    });

    aiChatLauncher.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openChatbox();
    });

    aiSend.addEventListener("click", sendMessage);

    aiInput.addEventListener("keypress", function(e){
        if(e.key === "Enter") sendMessage();
    });

    async function sendMessage(){

        const text = aiInput.value.trim();
        if(!text) return;

        addMessage("user", text);
        aiInput.value = "";

        const typingId = addTyping();

        try{
            const response = await fetch("/api/ai/chat", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ message: text, conversation: conversation })
            });

            const raw = await response.text();
            let data = null;

            try { data = raw ? JSON.parse(raw) : null; }
            catch { data = { reply: raw }; }

            removeTyping(typingId);

            addMessage("assistant", data?.reply || data?.message || "Xin lỗi, hiện chưa có phản hồi.");
        }
        catch{
            removeTyping(typingId);
            addMessage("assistant", "Đã xảy ra lỗi khi kết nối AI.");
        }

    }

    function addMessage(type, text){

        const wrapper = document.createElement("div");
        wrapper.className = `ai-message ${type}`;

        // ── NEW: chọn bubble class theo loại nội dung ────────────────
        const isDetail = type === "assistant" && isProductDetailBlock(text);
        const bubbleClass = isDetail ? "bubble bubble--detail" : "bubble";

        wrapper.innerHTML = `
            <div class="${bubbleClass}">
                ${type === "assistant" ? formatAssistantReply(text) : escapeHtml(text)}
            </div>
        `;

        aiMessages.appendChild(wrapper);
        scrollBottom();

        try{
            conversation.push({ role: type === "assistant" ? 'assistant' : 'user', content: String(text || '') });
            saveHistory(); // lưu localStorage
        }catch(e){ /* ignore */ }

    }

    // ── NEW: kiểm tra xem reply có phải block product-detail không ───
    function isProductDetailBlock(text){
        return /```product-detail[\s\S]*?```/.test(String(text || ""));
    }

    // ── NEW: parse block ```product-detail ... ``` thành object ─────
    function parseProductDetail(text){
        const match = String(text || "").match(/```product-detail\s*([\s\S]*?)```/);
        if(!match) return null;

        const data = {};
        match[1].trim().split('\n').forEach(function(line){
            const colonIdx = line.indexOf(':');
            if(colonIdx < 0) return;
            const key   = line.slice(0, colonIdx).trim();
            const value = line.slice(colonIdx + 1).trim();
            if(key) data[key] = value;
        });
        return data;
    }

    // ── NEW: render detail box từ data object ───────────────────────
    function renderDetailBox(data){

        if(!data) return '<div class="ai-plain-text">Không có dữ liệu.</div>';

        const name  = data.name        || "";
        const price = data.price       || "";
        const brand = data.brand       || "";
        const cpu   = data.cpu         || "";
        const ram   = data.ram         || "";
        const stor  = data.storage     || "";
        const desc  = data.description || "";
        const img   = data.image       || "";
        const link  = data.link        || "";

        // Định dạng giá
        let priceDisplay = "";
        if(price){
            const num = parseFloat(price.replace(/[^0-9.]/g, ""));
            priceDisplay = isNaN(num) ? price : num.toLocaleString("vi-VN") + " VND";
        }

        // Ảnh
        const imageHtml = img
            ? `<img class="ai-detail-box__img" src="${escapeHtml(img)}" alt="${escapeHtml(name)}" onerror="this.onerror=null;this.src='/images/laptop.png';" />`
            : `<div class="ai-detail-box__img--placeholder">Không có ảnh</div>`;

        // Thông số kỹ thuật
        let specsHtml = "";
        if(brand) specsHtml += `<div class="ai-detail-box__spec"><b>Hãng:</b><span>${escapeHtml(brand)}</span></div>`;
        if(cpu)   specsHtml += `<div class="ai-detail-box__spec"><b>CPU:</b><span>${escapeHtml(cpu)}</span></div>`;
        if(ram)   specsHtml += `<div class="ai-detail-box__spec"><b>RAM:</b><span>${escapeHtml(ram)}</span></div>`;
        if(stor)  specsHtml += `<div class="ai-detail-box__spec"><b>SSD:</b><span>${escapeHtml(stor)}</span></div>`;

        // Mô tả
        const descHtml = desc
            ? `<div class="ai-detail-box__desc">${escapeHtml(desc)}</div>`
            : "";

        // Nút mua
        const buyHtml = link
            ? `<a class="ai-buy-link" data-direct-checkout="1" href="${escapeHtml(link)}" target="_self" rel="noopener">Mua ngay</a>`
            : "";

        return `
            <div class="ai-detail-box">
                ${imageHtml}
                <div class="ai-detail-box__body">
                    <div class="ai-detail-box__name">${escapeHtml(name)}</div>
                    ${priceDisplay ? `<div class="ai-detail-box__price">${escapeHtml(priceDisplay)}</div>` : ""}
                    ${specsHtml ? `<div class="ai-detail-box__specs">${specsHtml}</div>` : ""}
                    ${descHtml}
                    ${buyHtml}
                </div>
            </div>
        `;
    }

    function formatAssistantReply(text){

        const raw = String(text ?? "");

        // ── NEW: ưu tiên xử lý product-detail block trước ───────────
        if(isProductDetailBlock(raw)){
            const data = parseProductDetail(raw);
            if(data) return renderDetailBox(data);
        }

        // Fallback: logic gợi ý sản phẩm cũ
        if (!hasProductMarkup(raw)) {
            return `<div class="ai-plain-text">${escapeHtml(raw).replace(/\r?\n/g, '<br />')}</div>`;
        }

        const lines = raw.split(/\r?\n/);
        const blocks = [];
        let currentCard = null;

        lines.forEach(function(line){
            const trimmed = line.trim();

            if(!trimmed) return;

            const markdownImageMatch = trimmed.match(/^!\[([^\]]*)\]\(([^)]+)\)(.*)$/);
            if(markdownImageMatch){
                currentCard = {
                    header: markdownImageMatch[3].trim() || markdownImageMatch[1].trim(),
                    details: [],
                    imageUrl: safeDecodeURIComponent(markdownImageMatch[2]),
                    buyUrl: ""
                };
                blocks.push({ type: "card", data: currentCard });
                return;
            }

            const bulletMatch = trimmed.match(/^[\-•*]\s*(.+)$/);
            if(bulletMatch){
                currentCard = {
                    header: bulletMatch[1].trim(),
                    details: [],
                    imageUrl: "",
                    buyUrl: ""
                };
                blocks.push({ type: "card", data: currentCard });
                return;
            }

            const buyLinkMatch = trimmed.match(/^\[Mua ngay\]\(([^)]+)\)$/i);
            if(buyLinkMatch && currentCard){
                currentCard.buyUrl = safeDecodeURIComponent(buyLinkMatch[1]);
                return;
            }

            if(currentCard){
                currentCard.details.push(trimmed);
                return;
            }

            blocks.push({ type: "text", text: trimmed });
        });

        return blocks.map(function(block){
            if(block.type === "text"){
                return `<div class="ai-plain-text">${escapeHtml(block.text).replace(/\r?\n/g, '<br />').replace(/Mua ngay/g, '<span class="ai-buy-now">Mua ngay</span>')}</div>`;
            }

            const header = block.data.header;
            let titlePart = header;
            let pricePart = "";
            let url = "";
            let imageUrl = "";
            let buyUrl = block.data.buyUrl || "";

            const buyNowMatch = header.match(/^(.*?)(?:\s+[—-]\s+Mua ngay:\s*)(https?:\/\/\S+|\/\S+)$/i);
            if(buyNowMatch){
                const prefix = buyNowMatch[1].trim();
                url = buyNowMatch[2].trim();
                const titleMatch = prefix.match(/^(.+?)(\s+[—-]\s+(.+))$/);
                if(titleMatch){
                    titlePart = titleMatch[1].trim();
                    pricePart = titleMatch[3].trim();
                }
                else{
                    titlePart = prefix;
                }
            }

            if (!url && buyUrl) url = buyUrl;

            let descriptionHtml = "";
            const specItems = [];
            (block.data.details || []).forEach(function(detail){
                const markdownImageMatch = String(detail || "").match(/^!\[([^\]]*)\]\(([^)]+)\)$/);
                const m = String(detail || "").match(/^\s*Mô tả:\s*(.+)$/i);
                const imageMatch = String(detail || "").match(/^\s*Ảnh:\s*(.+)$/i);
                const buyLinkMatch = String(detail || "").match(/^\[Mua ngay\]\(([^)]+)\)$/i);
                if(m){
                    descriptionHtml = `<div class="ai-product-desc">${escapeHtml(m[1].trim())}</div>`;
                }
                else if(markdownImageMatch){
                    imageUrl = safeDecodeURIComponent(markdownImageMatch[2]);
                }
                else if(imageMatch){
                    imageUrl = safeDecodeURIComponent(imageMatch[1]);
                }
                else if(buyLinkMatch){
                    url = safeDecodeURIComponent(buyLinkMatch[1]);
                }
                else if(detail && detail.trim()){
                    specItems.push(`<div class="ai-product-spec">${escapeHtml(detail)}</div>`);
                }
            });

            const safeImageUrl = imageUrl || '';
            const imageHtml = safeImageUrl
                ? `<img class="ai-product-thumb" src="${escapeHtml(safeImageUrl)}" alt="${escapeHtml(titlePart)}" onerror="this.onerror=null;this.src='/images/laptop.png';" />`
                : `<div class="ai-product-thumb ai-product-thumb--placeholder">No image</div>`;

            const specs = specItems.join("");

            const buyButton = url
                ? `<a class="ai-buy-link" data-direct-checkout="1" href="${escapeHtml(url)}" target="_self" rel="noopener">Mua ngay</a>`
                : "";

            return `
                <div class="ai-product-card">
                    <div class="ai-product-card__top">
                        ${imageHtml}
                        <div class="ai-product-main">
                            <div class="ai-product-title">${escapeHtml(titlePart)}</div>
                            ${pricePart ? `<div class="ai-product-price">${escapeHtml(pricePart)}</div>` : ""}
                            ${descriptionHtml}
                        </div>
                    </div>
                    ${specs ? `<div class="ai-product-specs">${specs}</div>` : ""}
                    ${buyButton}
                </div>
            `;
        }).join("");

    }

    function hasProductMarkup(text){
        return /!\[[^\]]*\]\([^)]+\)|^\s*[\-•*]\s+.+/m.test(String(text || "")) || /\[Mua ngay\]\([^)]+\)/i.test(String(text || ""));
    }

    function escapeHtml(value){
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");
    }

    function safeDecodeURIComponent(value){
        try{
            return decodeURIComponent(String(value || '').trim());
        }
        catch(e){
            return String(value || '').trim();
        }
    }

    function addTyping(){
        const id = "typing-" + Date.now();
        const wrapper = document.createElement("div");
        wrapper.className = "ai-message assistant";
        wrapper.id = id;
        wrapper.innerHTML = `
            <div class="bubble">
                <div class="typing">
                    <span></span><span></span><span></span>
                </div>
            </div>
        `;
        aiMessages.appendChild(wrapper);
        scrollBottom();
        return id;
    }

    function removeTyping(id){
        const el = document.getElementById(id);
        if(el) el.remove();
    }

    function scrollBottom(){
        aiMessages.scrollTop = aiMessages.scrollHeight;
    }

    aiMessages.addEventListener('click', function (e) {
        const el = e.target.closest && e.target.closest('.ai-buy-link');
        if (!el) return;
        if (el.getAttribute('data-direct-checkout') === '1') {
            e.preventDefault();
            if (e.stopImmediatePropagation) e.stopImmediatePropagation();
            e.stopPropagation();
            try {
                window.location.href = el.href;
            } catch (err) {
                window.open(el.href, '_self');
            }
        }
    }, false);

</script>
