
@*
    AI Chatbox Partial - Professional UI
    Requires:
    - Font Awesome
    - Bootstrap
*@

<div id="ai-chatbox" class="ai-chatbox">

    <button type="button" class="ai-chat-launcher ai-hidden" id="aiChatLauncher" aria-label="Mở AI chat">
        <i class="fas fa-robot"></i>
    </button>

    <!-- HEADER -->
    <div class="ai-chat-header" id="ai-chat-toggle">

        <div class="ai-header-info">

            <div class="ai-avatar">
                <i class="fas fa-robot"></i>
            </div>

            <div>
                <div class="ai-title">
                    AI Tư Vấn
                </div>

                <div class="ai-status">
                    <span class="dot"></span>
                    Đang hoạt động
                </div>
            </div>

        </div>

        <div class="ai-toggle-icon" id="toggleIcon">
            −
        </div>

    </div>

    <!-- BODY -->
    <div class="ai-chat-body" id="aiChatBody">

        <!-- MESSAGES -->
        <div id="aiMessages" class="ai-messages">

            <div class="ai-message assistant">
                <div class="bubble">
                    Xin chào 👋 <br />
                    Tôi có thể giúp bạn chọn laptop phù hợp với nhu cầu và ngân sách.
                </div>
            </div>

        </div>

        <!-- INPUT -->
        <div class="ai-input-row">

            <input id="aiInput"
                   type="text"
                   class="form-control"
                     placeholder="Hỏi về các sản phẩm của shop..." />

            <button id="aiSend">
                <i class="fas fa-paper-plane"></i>
            </button>

        </div>

    </div>

</div>

<style>

    .ai-chatbox{
        position:fixed;
        right:20px;
        bottom:30px;
        width:360px;
        max-width:92vw;
        z-index:3000;
        font-family:Poppins,sans-serif;
        animation:fadeUp .35s ease;
    }

    .ai-chatbox.is-collapsed{
        width:60px;
        height:60px;
    }

    @@keyframes fadeUp{
        from{
            opacity:0;
            transform:translateY(20px);
        }
        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    .ai-chat-header{
        background:linear-gradient(135deg,#1a1a2e,#0f3460);
        color:#fff;
        padding:14px 16px;
        border-radius:18px 18px 0 0;
        display:flex;
        align-items:center;
        justify-content:space-between;
        cursor:default;
        box-shadow:0 10px 30px rgba(15,52,96,.25);
    }

    .ai-chatbox.is-collapsed .ai-chat-header{
        display:none;
    }

    .ai-chat-launcher{
        width:60px;
        height:60px;
        border:none;
        border-radius:50%;
        display:flex;
        align-items:center;
        justify-content:center;
        background:linear-gradient(135deg,#1a1a2e,#0f3460);
        color:#fff;
        box-shadow:0 10px 30px rgba(15,52,96,.28);
        cursor:pointer;
        font-size:22px;
        position:absolute;
        right:0;
        bottom:0;
    }

    .ai-chat-launcher:hover{
        transform:translateY(-2px);
    }

    .ai-header-info{
        display:flex;
        align-items:center;
        gap:12px;
    }

    .ai-avatar{
        width:42px;
        height:42px;
        border-radius:50%;
        background:rgba(255,255,255,.15);
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:18px;
    }

    .ai-title{
        font-size:15px;
        font-weight:700;
        line-height:1.2;
    }

    .ai-status{
        font-size:12px;
        opacity:.9;
        display:flex;
        align-items:center;
        gap:6px;
        margin-top:2px;
    }

    .dot{
        width:8px;
        height:8px;
        background:#22c55e;
        border-radius:50%;
    }

    .ai-toggle-icon{
        font-size:24px;
        font-weight:300;
        cursor:pointer;
        padding-left:10px;
    }

    .ai-chat-body{
        background:rgba(255,255,255,.98);
        backdrop-filter:blur(10px);
        border:1px solid #e5e7eb;
        border-top:none;
        border-radius:0 0 18px 18px;
        overflow:hidden;
        display:flex;
        flex-direction:column;
        height:500px;
        box-shadow:0 10px 35px rgba(0,0,0,.12);
    }

    .ai-chatbox.is-collapsed .ai-chat-body{
        display:none;
    }

    .ai-messages{
        flex:1;
        overflow-y:auto;
        padding:16px;
        background:#f8fafc;
        scroll-behavior:smooth;
    }

    .ai-messages::-webkit-scrollbar{
        width:6px;
    }

    .ai-messages::-webkit-scrollbar-thumb{
        background:#cbd5e1;
        border-radius:20px;
    }

    .ai-message{
        display:flex;
        margin-bottom:14px;
        animation:fadeMessage .25s ease;
    }

    @@keyframes fadeMessage{
        from{
            opacity:0;
            transform:translateY(8px);
        }
        to{
            opacity:1;
            transform:translateY(0);
        }
    }

    .ai-message.user{
        justify-content:flex-end;
    }

    .ai-message.assistant{
        justify-content:flex-start;
    }

    .bubble{
        max-width:80%;
        padding:12px 14px;
        border-radius:16px;
        font-size:13px;
        line-height:1.6;
        box-shadow:0 2px 8px rgba(0,0,0,.05);
        word-break:break-word;
    }

    .ai-product-card{
        border:1px solid #e2e8f0;
        border-radius:16px;
        padding:12px 14px;
        background:linear-gradient(180deg,#fff 0%,#f8fbff 100%);
        box-shadow:0 8px 22px rgba(15,23,42,.06);
        margin-top:8px;
    }

    .ai-product-card__top{
        display:flex;
        align-items:flex-start;
        gap:12px;
    }

    .ai-product-thumb{
        width:72px;
        height:72px;
        flex:0 0 72px;
        border-radius:14px;
        border:1px solid #e2e8f0;
        object-fit:cover;
        background:#f8fafc;
        box-shadow:0 4px 10px rgba(15,23,42,.06);
    }

    .ai-product-thumb--placeholder{
        display:flex;
        align-items:center;
        justify-content:center;
        color:#94a3b8;
        font-size:11px;
        text-align:center;
        padding:8px;
    }

    .ai-product-title{
        color:#2563eb;
        font-weight:700;
        font-size:14px;
        line-height:1.35;
        margin-bottom:4px;
    }

    .ai-product-main{
        flex:1;
        min-width:0;
    }

    .ai-product-price{
        color:#0f172a;
        font-weight:700;
        font-size:13px;
    }

    .ai-product-specs{
        display:flex;
        flex-direction:column;
        gap:6px;
        margin-top:10px;
        color:#334155;
        font-size:12px;
        line-height:1.45;
    }

    .ai-product-spec{
        background:#fff;
        border:1px solid #e2e8f0;
        border-radius:10px;
        padding:8px 10px;
    }

    .ai-product-desc{
        margin-top:8px;
        color:#475569;
        font-size:13px;
        line-height:1.4;
    }

    .ai-product-name{
        color:#2563eb;
        font-weight:600;
    }

    .ai-buy-now{
        color:#dc2626;
        font-weight:700;
        background:#fee2e2;
        padding:0 6px;
        border-radius:999px;
    }

    .ai-buy-link{
        display:block;
        margin-top:10px;
        padding:8px 14px;
        border-radius:12px;
        background:linear-gradient(135deg,#2563eb,#1d4ed8);
        color:#fff !important;
        text-decoration:none !important;
        font-weight:700;
        font-size:13px;
        box-shadow:0 8px 18px rgba(29,78,216,.18);
        transition:transform .15s ease,box-shadow .15s ease,opacity .12s ease;
        border:1px solid rgba(255,255,255,.06);
    }

    .ai-buy-link:hover{
        transform:translateY(-3px);
        box-shadow:0 14px 30px rgba(29,78,216,.22);
        opacity:1;
    }

    .ai-message.user .bubble{
        background:linear-gradient(135deg,#2563eb,#1d4ed8);
        color:#fff;
        border-bottom-right-radius:4px;
    }

    .ai-message.assistant .bubble{
        background:#fff;
        color:#0f172a;
        border-bottom-left-radius:4px;
    }

    .typing{
        display:flex;
        gap:4px;
        align-items:center;
    }

    .typing span{
        width:6px;
        height:6px;
        background:#94a3b8;
        border-radius:50%;
        animation:typing .9s infinite;
    }

    .typing span:nth-child(2){
        animation-delay:.2s;
    }

    .typing span:nth-child(3){
        animation-delay:.4s;
    }

    @@keyframes typing{
        0%,100%{
            transform:translateY(0);
            opacity:.4;
        }
        50%{
            transform:translateY(-4px);
            opacity:1;
        }
    }

    .ai-input-row{
        display:flex;
        align-items:center;
        gap:10px;
        padding:14px;
        background:#fff;
        border-top:1px solid #f1f5f9;
    }

    .ai-input-row input{
        flex:1;
        border:none;
        background:#f1f5f9;
        border-radius:12px;
        padding:12px 14px;
        font-size:13px;
        outline:none;
        transition:.2s;
    }

    .ai-input-row input:focus{
        background:#fff;
        box-shadow:0 0 0 3px rgba(37,99,235,.12);
    }

    #aiSend{
        width:46px;
        height:46px;
        border:none;
        border-radius:12px;
        background:linear-gradient(135deg,#1a1a2e,#0f3460);
        color:#fff;
        transition:.25s;
    }

    #aiSend:hover{
        transform:translateY(-2px);
        opacity:.92;
    }

    .ai-hidden{
        display:none !important;
    }

</style>

<script>

    const aiMessages = document.getElementById("aiMessages");
    const aiInput = document.getElementById("aiInput");
    const aiSend = document.getElementById("aiSend");
    const aiChatBody = document.getElementById("aiChatBody");
    const toggleIcon = document.getElementById("toggleIcon");
    const aiChatLauncher = document.getElementById("aiChatLauncher");

    // Conversation history kept on client so follow-up messages can reference prior context
    const conversation = [];

    // Seed with assistant's initial greeting (matches the DOM starter message)
    conversation.push({ role: 'assistant', content: 'Xin chào 👋\nTôi có thể giúp bạn chọn laptop phù hợp với nhu cầu và ngân sách.' });

    function openChatbox() {
        aiChatBody.classList.remove("ai-hidden");
        document.getElementById("ai-chatbox").classList.remove("is-collapsed");
        aiChatLauncher.classList.add("ai-hidden");
        toggleIcon.innerText = "−";
        aiInput?.focus();
    }

    function collapseChatbox() {
        aiChatBody.classList.add("ai-hidden");
        document.getElementById("ai-chatbox").classList.add("is-collapsed");
        aiChatLauncher.classList.remove("ai-hidden");
        toggleIcon.innerText = "+";
    }

    // COLLAPSE ONLY FROM THE MINUS ICON
    toggleIcon.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        collapseChatbox();
    });

    // OPEN ONLY FROM THE ROBOT LAUNCHER
    aiChatLauncher.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        openChatbox();
    });

    // SEND BUTTON
    aiSend.addEventListener("click", sendMessage);

    // ENTER KEY
    aiInput.addEventListener("keypress", function(e){

        if(e.key === "Enter"){
            sendMessage();
        }

    });

    async function sendMessage(){

        const text = aiInput.value.trim();

        if(!text) return;

        addMessage("user", text);

        // Add user message to local conversation history (addMessage will also push but ensure it's present)
        // (addMessage pushes below, so no duplicate needed here)

        aiInput.value = "";

        // Typing loading
        const typingId = addTyping();

        try{

            const response = await fetch("/api/ai/chat", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    message: text,
                    conversation: conversation
                })

            });

            const raw = await response.text();
            let data = null;

            try {
                data = raw ? JSON.parse(raw) : null;
            }
            catch {
                data = { reply: raw };
            }

            removeTyping(typingId);

            addMessage(
                "assistant",
                data?.reply || data?.message || "Xin lỗi, hiện chưa có phản hồi."
            );

        }
        catch{

            removeTyping(typingId);

            addMessage(
                "assistant",
                "Đã xảy ra lỗi khi kết nối AI."
            );

        }

    }

    function addMessage(type, text){

        const wrapper = document.createElement("div");

        wrapper.className = `ai-message ${type}`;

        wrapper.innerHTML = `
            <div class="bubble">
                ${type === "assistant" ? formatAssistantReply(text) : escapeHtml(text)}
            </div>
        `;

        aiMessages.appendChild(wrapper);

        scrollBottom();

        // Record the raw message in conversation history so follow-ups carry context
        try{
            conversation.push({ role: type === "assistant" ? 'assistant' : 'user', content: String(text || '') });
        }catch(e){ /* ignore */ }

    }

    function formatAssistantReply(text){

        const lines = String(text ?? "").split(/\r?\n/);
        const blocks = [];
        let currentCard = null;

        lines.forEach(function(line){
            const trimmed = line.trim();

            if(!trimmed){
                currentCard = currentCard;
                return;
            }

            const bulletMatch = trimmed.match(/^[\-•*]\s*(.+)$/);

            if(bulletMatch){
                currentCard = {
                    header: bulletMatch[1].trim(),
                    details: [],
                    imageUrl: ""
                };
                blocks.push({ type: "card", data: currentCard });
                return;
            }

            if(currentCard){
                currentCard.details.push(trimmed);
                return;
            }

            blocks.push({ type: "text", text: trimmed });
        });

        return blocks.map(function(block){
            if(block.type === "text"){
                return escapeHtml(block.text).replace(/Mua ngay/g, '<span class="ai-buy-now">Mua ngay</span>');
            }

            const header = block.data.header;
            const buyNowMatch = header.match(/^(.*?)(?:\s+[—-]\s+Mua ngay:\s*)(https?:\/\/\S+|\/\S+)$/i);
            let titlePart = header;
            let pricePart = "";
            let url = "";
            let imageUrl = "";

            if(buyNowMatch){
                const prefix = buyNowMatch[1].trim();
                url = buyNowMatch[2].trim();
                const titleMatch = prefix.match(/^(.+?)(\s+[—-]\s+(.+))$/);
                if(titleMatch){
                    titlePart = titleMatch[1].trim();
                    pricePart = titleMatch[3].trim();
                }
                else{
                    titlePart = prefix;
                }
            }

            // Extract a short description if present (lines starting with "Mô tả:")
            let descriptionHtml = "";
            const specItems = [];
            (block.data.details || []).forEach(function(detail){
                const m = String(detail || "").match(/^\s*Mô tả:\s*(.+)$/i);
                const imageMatch = String(detail || "").match(/^\s*Ảnh:\s*(.+)$/i);
                if(m){
                    descriptionHtml = `<div class="ai-product-desc">${escapeHtml(m[1].trim())}</div>`;
                }
                else if(imageMatch){
                    imageUrl = safeDecodeURIComponent(imageMatch[1]);
                }
                else if(detail && detail.trim()){
                    specItems.push(`<div class="ai-product-spec">${escapeHtml(detail)}</div>`);
                }
            });

            const safeImageUrl = imageUrl || '/images/laptop.png';
            const imageHtml = safeImageUrl
                ? `<img class="ai-product-thumb" src="${escapeHtml(safeImageUrl)}" alt="${escapeHtml(titlePart)}" onerror="this.onerror=null;this.src='/images/laptop.png';" />`
                : `<div class="ai-product-thumb ai-product-thumb--placeholder">No image</div>`;

            const specs = specItems.join("");

            const buyButton = url
                ? `<a class="ai-buy-link" data-direct-checkout="1" href="${escapeHtml(url)}" target="_self" rel="noopener">Mua ngay</a>`
                : "";

            return `
                <div class="ai-product-card">
                    <div class="ai-product-card__top">
                        ${imageHtml}
                        <div class="ai-product-main">
                            <div class="ai-product-title">${escapeHtml(titlePart)}</div>
                            ${pricePart ? `<div class="ai-product-price">${escapeHtml(pricePart)}</div>` : ""}
                            ${descriptionHtml}
                        </div>
                    </div>
                    ${specs ? `<div class="ai-product-specs">${specs}</div>` : ""}
                    ${buyButton}
                </div>
            `;
        }).join("");

    }

    function escapeHtml(value){

        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#39;");

    }

    function safeDecodeURIComponent(value){
        try{
            return decodeURIComponent(String(value || '').trim());
        }
        catch(e){
            return String(value || '').trim();
        }
    }

    function addTyping(){

        const id = "typing-" + Date.now();

        const wrapper = document.createElement("div");

        wrapper.className = "ai-message assistant";

        wrapper.id = id;

        wrapper.innerHTML = `
            <div class="bubble">
                <div class="typing">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        `;

        aiMessages.appendChild(wrapper);

        scrollBottom();

        return id;

    }

    function removeTyping(id){

        const el = document.getElementById(id);

        if(el){
            el.remove();
        }

    }

    function scrollBottom(){

        aiMessages.scrollTop = aiMessages.scrollHeight;

    }

    // Delegate click for buy links inside AI messages to force direct navigation to Checkout
    aiMessages.addEventListener('click', function (e) {
        const el = e.target.closest && e.target.closest('.ai-buy-link');
        if (!el) return;
        // If this buy link is marked as direct-checkout, navigate directly (prevent other handlers)
        if (el.getAttribute('data-direct-checkout') === '1') {
            e.preventDefault();
            // prevent any other listeners on the same event from running
            if (e.stopImmediatePropagation) e.stopImmediatePropagation();
            e.stopPropagation();
            try {
                window.location.href = el.href;
            } catch (err) {
                // fallback: open in same tab
                window.open(el.href, '_self');
            }
        }
    }, false);

</script>
